---
const pathname = new URL(Astro.request.url).pathname;
const {
	title,
	description = "Independent studio building high-utility Apple-native apps for learning Korean, Japanese, and Chinese, plus culture notes on the languages themselves.",
	image = "/sanserif-og.jpg",
} = Astro.props;

const canonicalURL = new URL(pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const logoURL = new URL('/sanserif.jpg', Astro.site);

// Organization identity, not per-page content — same on every page so
// Google/AI crawlers have one consistent, machine-readable answer to "who
// is san serif," rather than inferring it solely from prose. This is the
// direct lever for disambiguating the brand from the generic typography
// term "sans serif" — backlinks and branded search do the rest over time,
// but this is the part a single site change can actually contribute.
const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: "san serif",
	url: Astro.site?.toString(),
	logo: logoURL.toString(),
	description: "Independent studio building high-utility Apple-native apps for learning Korean, Japanese, and Chinese, plus culture notes on the languages themselves.",
	sameAs: ["https://x.com/sanserif_studio"],
};

// SMART NAV STATE
const isHome =
	pathname === "/" ||
	(!pathname.startsWith("/notes") && !pathname.startsWith("/about"));

const isNotes = pathname.startsWith("/notes");
const isAbout = pathname.startsWith("/about");
---

<!doctype html>
<html lang="en-AU">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="san serif" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />

		<!-- Cloudflare Web Analytics -->
		<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "700489b2a11741ef8b56d44a703ce7b3"}' is:inline></script>
		<!-- End Cloudflare Web Analytics -->

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Noto+Sans+JP:wght@400..800&family=Noto+Sans+KR:wght@400..800&display=swap" rel="stylesheet">
	</head>

	<body>
		<nav class="nav wrapper">
			<div class="brand">
				<a href="/" class="logo">
					<img src="/sanserif.jpg" alt="san serif" class="logo-img" />
				</a>
				<p class="subtitle">language apps & culture notes</p>
			</div>

			<div class="links">
				<a href="/" class={isHome ? "active" : ""}>Apps</a>
				<a href="/notes" class={isNotes ? "active" : ""}>Notes</a>
				<a href="/about" class={isAbout ? "active" : ""}>About</a>
			</div>
		</nav>

		<slot />
	</body>
</html>

<style is:global>
	* { box-sizing: border-box; -webkit-font-smoothing: antialiased; }

	html {
		width: 100%;
		height: 100%;
		background: #ffffff !important;
	}

	body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100vh;
		/* Pure white background */
		background: #ffffff !important; 
		color: #1a1a1a;
		font-family: "Inter", "Noto Sans JP", "Noto Sans KR", -apple-system, sans-serif;
	}

	/* THE TRANSPARENCY GUARD: Forces browsers to respect video alpha channels */
	video {
		background-color: transparent !important;
		-webkit-mask-image: -webkit-radial-gradient(white, black); /* Fixes some Safari rounded corner bugs */
	}

	.wrapper { 
		max-width: 1100px; 
		margin: 0 auto; 
		padding: 0 20px;
		background: #ffffff !important;
	}

	main {
		background: #ffffff !important;
	}

	/* --- NAV CONTAINER --- */
	.nav { 
		display: flex; 
		justify-content: space-between; 
		align-items: flex-start; 
		padding-top: 60px;
		margin-bottom: 80px; 
	}

	.brand { 
		display: flex; 
		flex-direction: column; 
	}

	.logo-img {
		height: 60px; 
		width: auto;
		display: block;
		/* Removed mix-blend-mode for pure white background */
	}

	.subtitle { 
		font-size: 0.8rem; 
		color: #999; 
		margin-top: 10px; 
		font-weight: 400; 
	}

	/* --- CAPSULE NAV --- */
	.links { 
		display: flex; 
		gap: 10px; 
		padding: 6px;
		border-radius: 999px;
		/* Solid white for pure white background */
		background: rgba(255, 255, 255, 1);
		border: 1px solid rgba(0, 0, 0, 0.05);
		align-items: center;
	}

	.links a { 
		color: #888;
		font-size: 0.85rem;
		font-weight: 500;
		text-decoration: none;
		padding: 8px 14px;
		border-radius: 999px;
		transition: all 0.25s ease;
	}

	.links a:hover { 
		color: #111;
		background: rgba(255, 255, 255, 1);
		transform: translateY(-1px);
	}

	.links a.active { 
		color: #111;
		background: rgba(0, 0, 0, 0.08);
		font-weight: 600;
	}

	/* --- RESPONSIVE --- */
	@media (max-width: 600px) {
		.nav { 
			padding-top: 40px; 
			margin-bottom: 40px; 
			gap: 24px; 
			flex-direction: column; 
		}

		.links {
			align-self: flex-start;
		}
	}
</style>