---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import LevelBadge from '../../components/LevelBadge.astro';
import { groupByLevel, courseSequence, parseTitle } from '../../lib/notesGrouping';
import { chineseTitleCue } from '../../lib/chineseTitleCue';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  const courseInfo = {
    japanese: { name: 'Japanese', native: '日本語', category: 'JAPANESE', intro: 'From your first sentence to subtle shifts in tone and meaning.' },
    korean: { name: 'Korean', native: '한국어', category: 'KOREAN', intro: 'Build the patterns you need for natural conversation.' },
    chinese: { name: 'Chinese', native: '中文', category: 'CHINESE', intro: 'Learn how words and patterns work together in real sentences.' },
  } as const;
  return Object.entries(courseInfo).map(([language, info]) => ({
    params: { language },
    props: { info, sequence: courseSequence(notes, info.category) },
  }));
}

const { info, sequence } = Astro.props;
const groups = groupByLevel(sequence);
const first = sequence[0];
const lessonURL = (note: typeof sequence[number]) => `/notes/${note.slug || note.id}`;
const stageNames: Record<string, string> = {
  N5: 'First conversations', N4: 'Everyday expression', N3: 'Connecting ideas', N2: 'Nuance and inference', N1: 'Formal and subtle expression',
  'TOPIK I': 'Everyday foundations', 'TOPIK II': 'Further patterns',
  'HSK 1': 'First sentences', 'HSK 2': 'Everyday exchanges', 'HSK 3': 'Longer conversations', 'HSK 4': 'Detail and contrast',
  'HSK 5': 'Complex expression', 'HSK 6': 'Flexible language', 'HSK 7–9': 'Advanced expression',
};
const stageStart = (index: number) => 1 + groups.slice(0, index).reduce((sum, group) => sum + group.notes.length, 0);
---

<Layout title={`Learn ${info.name} | san serif`} description={`Free ${info.name} grammar lessons in order by level, with clear examples and a place to continue studying.`}>
  <main class="course-page wrapper">
    <a class="back-link" href="/learn">← All languages</a>
    <header class="course-header">
      <p class="eyebrow">LANGUAGE COURSE</p>
      <h1>{info.name} <span>{info.native}</span></h1>
      <p>{info.intro}</p>
      <div class="course-meta">{sequence.length} lessons · {groups.length} levels · Free to read</div>
      {first && <a class="start-link" id="continue-link" href={lessonURL(first)}>Start with lesson 1 <span aria-hidden="true">→</span></a>}
      <p class="progress-copy" id="progress-copy" aria-live="polite"></p>
    </header>

    <div class="course-guide">
      <h2>A suggested route.</h2>
      <p>Start with the foundations, then choose the topics you need within each level. The numbers show a useful order, not a requirement. Open any lesson; your last viewed and completed lessons are marked here in this browser.</p>
    </div>

    <div class="levels">
      {groups.map((group, index) => (
        <details class="level" open={index === 0}>
          <summary><span class="stage-number">{String(index + 1).padStart(2, '0')}</span><LevelBadge level={group.level} /><span class="stage-name">{stageNames[group.level]}</span><span class="level-count">{group.notes.length} lessons</span><span class="level-chevron" aria-hidden="true">⌄</span></summary>
          <ol class="lesson-list">
            {group.notes.map((note, lessonIndex) => {
              const title = parseTitle(note.data.title);
              const cue = chineseTitleCue(note);
              return <li><a href={lessonURL(note)} data-lesson-id={note.id}><span class="lesson-number">{String(stageStart(index) + lessonIndex).padStart(2, '0')}</span><span class="lesson-name">{title.main}</span>{title.detail ? <span class="lesson-script">{title.detail}</span> : cue && <span class="lesson-script" lang="zh">例 · {cue}</span>}<span class="lesson-status"><span class="lesson-last" hidden>Last viewed</span><span class="lesson-done" aria-label="Completed" hidden>✓</span></span></a></li>;
            })}
          </ol>
        </details>
      ))}
    </div>
  </main>
</Layout>

<script is:inline>
  const storageKey = 'sanserif:completed:v1';
  let completed = [];
  try { completed = JSON.parse(localStorage.getItem(storageKey) || '[]'); } catch {}
  if (!Array.isArray(completed)) completed = [];
  const links = [...document.querySelectorAll('[data-lesson-id]')];
  for (const link of links) {
    if (completed.includes(link.dataset.lessonId)) link.querySelector('.lesson-done').hidden = false;
  }
  const course = location.pathname.split('/').filter(Boolean)[1];
  let saved = null;
  try { saved = JSON.parse(localStorage.getItem('sanserif:last:v1') || '{}')[course]; } catch {}
  const savedIndex = links.findIndex(link => link.dataset.lessonId === saved?.id);
  const savedLink = savedIndex >= 0 ? links[savedIndex] : null;
  if (savedLink) {
    savedLink.querySelector('.lesson-last').hidden = false;
    savedLink.closest('details').open = true;
  }
  const firstUnfinished = links.find(link => !completed.includes(link.dataset.lessonId));
  const afterSaved = savedIndex >= 0
    ? links.slice(savedIndex + 1).find(link => !completed.includes(link.dataset.lessonId))
    : null;
  const resume = savedLink && !completed.includes(saved.id) ? savedLink : afterSaved || firstUnfinished;
  const continueLink = document.getElementById('continue-link');
  const progressCopy = document.getElementById('progress-copy');
  const doneCount = links.length - links.filter(link => !completed.includes(link.dataset.lessonId)).length;
  if (continueLink && resume && (doneCount > 0 || savedLink)) {
    continueLink.href = resume.href;
    continueLink.firstChild.textContent = resume === savedLink ? 'Resume your last lesson ' : 'Continue learning ';
    resume.closest('details').open = true;
  }
  if (continueLink && !resume && links.length) {
    continueLink.href = links[0].href;
    continueLink.firstChild.textContent = 'Review from the beginning ';
  }
  if (progressCopy && doneCount) progressCopy.textContent = `${doneCount} of ${links.length} lessons completed in this browser`;
</script>

<style>
  .course-page { max-width: 820px; padding: 10px 20px 120px; }
  .back-link { color: #888; text-decoration: none; font-size: .82rem; font-weight: 600; }
  .back-link:hover { color: #111; }
  .course-header { margin: 60px 0 80px; }
  .eyebrow { color: #888; font-size: .7rem; font-weight: 700; letter-spacing: .15em; margin: 0 0 18px; }
  h1 { margin: 0 0 18px; font-size: clamp(2.8rem, 6vw, 5rem); line-height: 1.05; letter-spacing: -.065em; }
  h1 span { display: block; color: #aaa; font-size: .55em; font-weight: 450; letter-spacing: -.01em; margin-top: 8px; }
  .course-header > p:not(.eyebrow, .progress-copy) { color: #666; font-size: 1rem; line-height: 1.7; margin: 0 0 14px; }
  .course-meta { color: #888; font-size: .82rem; margin: 0 0 28px; }
  .start-link { display: inline-flex; gap: 20px; align-items: center; background: #111; color: #fff; padding: 14px 18px; border-radius: 8px; text-decoration: none; font-size: .86rem; font-weight: 600; }
  .start-link:hover { background: #333; }
  .progress-copy { min-height: 1em; color: #888; font-size: .76rem; margin: 14px 0 0; }
  .course-guide { display: grid; grid-template-columns: 220px 1fr; gap: 24px; padding: 28px 0; border-top: 1px solid #e9e9e9; }
  .course-guide h2 { font-size: 1.1rem; margin: 0; letter-spacing: -.03em; }
  .course-guide p { margin: 0; color: #777; font-size: .86rem; line-height: 1.65; }
  .levels { border-top: 1px solid #e9e9e9; }
  .level { border-bottom: 1px solid #e9e9e9; }
  .level summary { cursor: pointer; display: flex; align-items: center; gap: 16px; padding: 22px 0; list-style: none; }
  .level summary::-webkit-details-marker { display: none; }
  .stage-number { width: 24px; flex: none; color: #aaa; font-size: .72rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .stage-name { color: #333; font-size: .9rem; font-weight: 600; }
  .level-count { margin-left: auto; color: #999; font-size: .78rem; white-space: nowrap; }
  .level-chevron { color: #999; transition: transform .2s; }
  .level[open] .level-chevron { transform: rotate(180deg); }
  .lesson-list { list-style: none; margin: 0 0 20px; padding: 0; }
  .lesson-list li { border-top: 1px solid #f1f1f1; }
  .lesson-list a { display: flex; align-items: baseline; gap: 10px; padding: 13px 0; color: #222; text-decoration: none; font-size: .9rem; }
  .lesson-list a:hover .lesson-name { text-decoration: underline; text-underline-offset: 3px; }
  .lesson-number { width: 40px; flex: none; color: #aaa; font-size: .75rem; font-variant-numeric: tabular-nums; }
  .lesson-script { color: #999; font-size: .82rem; }
  .lesson-status { display: inline-flex; align-items: center; gap: 10px; margin-left: auto; white-space: nowrap; }
  .lesson-last { color: #555; background: #f3f3f3; border: 1px solid #dedede; border-radius: 999px; padding: 3px 8px; font-size: .69rem; font-weight: 600; }
  .lesson-done { color: #222; font-weight: 700; }
  @media (max-width: 760px) { .course-header { margin: 45px 0 60px; } .course-guide { grid-template-columns: 1fr; gap: 8px; } .lesson-list a { flex-wrap: wrap; } .level summary { gap: 9px; flex-wrap: wrap; } .stage-name { flex-basis: calc(100% - 33px); margin-left: 33px; order: 3; } .level-chevron { order: 2; } }
</style>
