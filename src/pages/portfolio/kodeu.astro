---
import DeveloperAppPage from '../../components/DeveloperAppPage.astro';
---

<DeveloperAppPage
  name="Kodeu"
  status="NATIVE MAC APP"
  summary="A native Mac editor for code, scripts, and Markdown."
  description="Kodeu is a free, native code editor for macOS. Open a project, work across files, and write code in a focused Mac editor with syntax highlighting, formatting, and everything you need — no account required."
  appStoreUrl="https://apps.apple.com/au/app/kodeu-code-text-editor/id6826537145?mt=12"
  premiumHeading="Keep the whole coding loop in one place."
  premiumSummary="Stay in the editor when a project gets complex. Kodeu Premium is being built for the work around the code, from reviewing changes to finding your way through a project and running commands."
  icon="/kodeu-icon.png"
  screenshots={[
    { src: '/images/kodeu/editor.jpg', alt: 'Kodeu editing Swift code with a project sidebar' },
    { src: '/images/kodeu/markdown.jpg', alt: 'Kodeu editing a Markdown document' },
  ]}
  premiumFeatures={[
    { title: 'Review every change', description: 'See Git status and diffs beside your files. For connected coding agents, inspect captured edits and choose whether to keep or restore them.' },
    { title: 'Find the code you need', description: 'In Swift projects, compiler completion, SourceKit diagnostics, and Go to Definition help you trace errors to the relevant code.' },
    { title: 'Build without switching apps', description: 'Run commands in an integrated terminal, build a project, and keep multiple files in view with a split editor.' },
    { title: 'Shape the editor to your work', description: 'Use multiple carets, regex search and replacement across files, imported themes and snippets, and project-specific settings.' },
  ]}
  coreFeatures={[
    { title: 'Write in any language', description: 'Syntax highlighting for Swift, C-family languages, JavaScript, TypeScript, Python, HTML, CSS, JSON, Markdown, Rust, and many more — with code folding, bracket matching, and automatic indentation.' },
    { title: 'Move through a project', description: 'Browse files, open quickly, search the project, find and replace in a file, go to a line, and browse document symbols.' },
    { title: 'Format locally', description: 'Format supported languages locally with bundled Prettier for JavaScript, TypeScript, HTML, CSS, Markdown, and JSONC — no cloud, no account.' },
    { title: 'Work your way', description: 'Work in tabs or separate windows, recover unsaved edits after a restart, use built-in snippets, and save project-specific indentation defaults.' },
    { title: 'Print and export', description: 'Print the active document or save it as a PDF through the macOS print dialog.' },
    { title: 'Private by design', description: 'Kodeu does not require an account or upload your source code. It is an independent editor built for the Mac.' },
  ]}
/>
