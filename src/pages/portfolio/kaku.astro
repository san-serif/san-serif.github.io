---
import Layout from '../../layouts/Layout.astro';
import AppPurchaseGuide from '../../components/AppPurchaseGuide.astro';
import AppPurchaseSummary from '../../components/AppPurchaseSummary.astro';
---

<Layout title="Kaku | san serif" description="A Japanese notebook for learning in the flow of writing: instant offline dictionary lookups, form insertion, word-by-word reading and listening, on-device writing suggestions, OCR and optional iCloud sync." image="/images/kaku-poster.jpg">
	<main class="wrapper">

		<section class="app-hero">

			<div class="video-container">
				<div class="video-glow"></div>

				<video
					autoplay
					loop
					muted
					playsinline
					webkit-playsinline
					poster="/images/kaku-poster.jpg"
					class="hero-watch-video"
					style="background-color: transparent !important;"
				>
					<source src="/videos/kaku.mp4" type="video/mp4">
				</video>
			</div>

			<div class="app-intro">
				<h1>Kaku</h1>
				<p class="description">
					Write Japanese with your dictionary just above the keyboard. Look up words as they change form, insert conjugations into a note, and ask for on-device writing suggestions when you want a second pair of eyes.
				</p>

				<a href="https://apps.apple.com/au/app/kaku-japanese-dictionary/id1515101339" class="app-store-link">
					<img src="/images/app-store-badge.svg" alt="Download on the App Store" class="badge-svg" />
				</a>
                <AppPurchaseSummary app="kaku" />
			</div>

		</section>

		<div class="divider"></div>

		<section class="details-grid">

			<div class="detail-card">
				<div class="floating-container">
					<img src="/images/kaku-dict.png" alt="Kaku offline Japanese dictionary" class="modular-image" />
				</div>
				<h3>Instant Dictionary</h3>
				<p>Highlight any word as you write and matching entries appear right above the keyboard, readings, word types, and real example sentences included. Powered by a built-in offline dictionary, so lookups are instant and work anywhere.</p>
			</div>

			<div class="detail-card">
				<div class="floating-container">
					<img src="/images/kaku-conjugation.png" alt="Kaku conjugated Japanese word insertion" class="modular-image" />
				</div>
				<h3>Write With Training Wheels</h3>
				<p>Stuck on a word? Highlight the English and insert the Japanese in one tap, already in the conjugated form your sentence actually needs.</p>
			</div>

			<div class="detail-card">
				<div class="floating-container">
					<img src="/images/kaku-translation.png" alt="Translate a note" class="modular-image" />
				</div>
				<h3>Translate Your Notes</h3>
				<p>Check your sentence structure by translating an entire note into your native language, with support for 20 languages.</p>
			</div>

		</section>

        <AppPurchaseGuide app="kaku" />
	</main>
</Layout>

<style>
	.wrapper {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 20px;
	}

	h1, p {
		margin-block: 0;
	}

	.app-hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding-top: 30px;
		gap: 24px;
		isolation: isolate;
	}

	.video-container {
		position: relative;
		width: 100%;
		max-width: 480px;
		display: flex;
		justify-content: center;
		margin-top: 0;
		transform: translateY(-10px);
		background: transparent !important;
	}

	.video-glow {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 100%;
		aspect-ratio: 1;
		pointer-events: none;
	}

	.hero-watch-video {
		width: 100%;
		height: auto;
		display: block;
		transform: translateZ(0);
		will-change: contents;
		backface-visibility: hidden;
		background: transparent !important;
		outline: none;
		border: none;
	}

	.app-intro {
		z-index: 2;
	}

	h1 {
		font-size: 3.5rem;
		font-weight: 600;
		letter-spacing: -0.05em;
		margin-bottom: 10px;
		color: #111;
	}

	.description {
		max-width: 580px;
		font-size: 1.2rem;
		color: #555;
		line-height: 1.6;
		margin-bottom: 30px;
	}

	.app-store-link {
		display: inline-block;
		transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
	}

	.app-store-link:hover {
		transform: scale(1.04) translateY(-4px);
	}

	.badge-svg {
		height: 52px;
		width: auto;
		display: block;
		filter: drop-shadow(0 12px 25px rgba(0,0,0,0.08));
	}

	.divider {
		height: 1px;
		background: #ffffff;
		margin: 30px 0;
	}

	.details-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 60px;
		margin-bottom: 120px;
	}

	.detail-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.floating-container {
		width: 100%;
		aspect-ratio: 1.5 / 1;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 2px;
	}

	.modular-image {
		max-width: 75%;
		max-height: 100%;
		width: auto;
		height: auto;
		border-radius: 20px;
		box-shadow: 0 20px 50px rgba(0,0,0,0.12), 0 0 0 1px rgba(0,0,0,0.04);
		transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
	}

	.detail-card:hover .modular-image {
		transform: scale(1.05) translateY(-10px);
	}

	h3 {
		font-size: 0.75rem;
		text-transform: uppercase;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: #111;
		margin-bottom: 16px;
	}

	.detail-card p {
		font-size: 0.95rem;
		color: #555;
		line-height: 1.7;
		max-width: 260px;
		margin: 0;
	}

	@media (max-width: 900px) {
		.details-grid {
			grid-template-columns: 1fr;
			gap: 40px;
		}

		h1 {
			font-size: 2.8rem;
		}
	}
</style>
