---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Language Apps & Culture Notes | san serif" description="Sajeon, Kaku, TokeiTango, Eohwi, Zungzi, Yinpin, Tsugi, and more: Apple-native apps for learning Korean, Japanese, and Chinese, built by an independent studio focused on minimal friction and long-term retention.">
	<main class="wrapper">
		<section class="grid">

			{/* SAJEON */}
			<a href="/portfolio/sajeon" class="card sajeon">
				<img src="/sajeon-icon.png" alt="Sajeon" class="app-icon hero-icon" />
				<div class="card-content">
					<span class="category">iOS, iPadOS, macOS / KR</span>
					<h2>Sajeon</h2>
					<p>
						A native Korean dictionary built for deep immersion. Beyond rapid search, Sajeon features a powerful clipboard reader to deconstruct complex sentences for translation and shadow reading. Curate your progress with custom word lists and extensive catalogue of vocabulary, all within a distilled interface that stays out of your way.
					</p>
				</div>
			</a>

			{/* KAKU */}
			<a href="/portfolio/kaku" class="card kaku">
				<img src="/kaku-icon.png" alt="Kaku" class="app-icon standard-icon" />
				<div class="card-content">
					<span class="category">iOS, iPadOS, macOS / JP</span>
					<h2>Kaku</h2>
					<p>A Japanese notebook built to keep you writing, not switching apps.</p>
				</div>
			</a>

			{/* TSUGI */}
			<a href="/portfolio/tsugi" class="card tsugi placeholder-card">
				<div class="icon-placeholder">Icon<br>pending</div>
				<div class="card-content">
					<span class="category">iOS, iPadOS / JP</span>
					<h2>Tsugi</h2>
					<p>AI-powered sentence mining for learners who've outgrown basic flashcards.</p>
				</div>
			</a>

			{/* YINPIN */}
			<a href="/portfolio/yinpin" class="card yinpin placeholder-card">
				<div class="icon-placeholder">Icon<br>pending</div>
				<div class="card-content">
					<span class="category">iOS, iPadOS / CN</span>
					<h2>Yinpin</h2>
					<p>Master Pinyin and you can type any Chinese character you know, no handwriting required.</p>
				</div>
			</a>

			{/* TOKEITANGO */}
			<a href="/portfolio/tokeitango" class="card tokei">
				<img src="/tokeitango-icon.png" alt="tokeitango" class="app-icon standard-icon" />
				<div class="card-content">
					<span class="category">watchOS / JP</span>
					<h2>TokeiTango</h2>
					<p>
						JLPT vocabulary and study sessions, reimagined for the wrist.
					</p>
				</div>
			</a>

			{/* EOHWI */}
			<a href="/portfolio/eohwi" class="card eohwi">
				<img src="/eohwi-icon.png" alt="Eohwi" class="app-icon standard-icon" />
				<div class="card-content">
					<span class="category">watchOS / KR</span>
					<h2>Eohwi</h2>
					<p>Master TOPIK vocabulary on the go, directly on your Apple Watch.</p>
				</div>
			</a>

			{/* ZUNGZI */}
			<a href="/portfolio/zungzi" class="card zungzi">
				<img src="/images/zungzi-hsk.png" alt="Zungzi" class="zungzi-shot" />
				<div class="card-content">
					<span class="category">watchOS / CN</span>
					<h2>Zungzi</h2>
					<p>Conquer Chinese Hanzi from anywhere, one glance at a time.</p>
				</div>
			</a>

			{/* UTILITIES */}
			<a href="https://apps.apple.com/us/app-bundle/asian-language-menubar/id1793885201?mt=12" class="card utilities">
				<div class="icons-row">
					<img src="/jbar-icon.png" alt="JBar" class="app-icon mini" />
					<img src="/kbar-icon.png" alt="KBar" class="app-icon mini" />
					<img src="/cbar-icon.png" alt="CBar" class="app-icon mini" />
				</div>
				<div class="content">
					<span class="category">macOS / JP, KR, CN</span>
					<h2>Menubar App Bundle</h2>
					<p>Minimal utilities that keep your target language integrated into your daily workflow.</p>
				</div>
			</a>

		</section>
	</main>
</Layout>

<style>
.wrapper {
	padding-bottom: 100px;
}

.grid {
	display: grid;
	grid-template-columns: repeat(4, minmax(0, 1fr));
	grid-template-rows: minmax(200px, auto) minmax(200px, auto) minmax(140px, auto);
	gap: 20px;
}

/* BASE CARD */
.card {
	background: #ffffff;
	border: 1px solid rgba(0, 0, 0, 0.2);
	border-radius: 32px;
	padding: 32px;
	display: flex;
	flex-direction: column;
	text-decoration: none;
	min-width: 0;
	cursor: pointer;
	transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.card-content, .content {
	display: flex;
	flex-direction: column;
	margin-top: auto;
}

/* HOVER STATES */
.card:hover {
	transform: translateY(-6px);
	border-color: rgba(0, 0, 0, 0.1);
	background: #ffffff;
}

/* --- BENTO PLACEMENT --- */
.sajeon { grid-column: 1; grid-row: 1 / span 2; }

.kaku { grid-column: 2; grid-row: 1; }
.tsugi { grid-column: 3; grid-row: 1; }
.yinpin { grid-column: 4; grid-row: 1; }

.tokei { grid-column: 2; grid-row: 2; }
.zungzi { grid-column: 3; grid-row: 2; }
.eohwi { grid-column: 4; grid-row: 2; }

.utilities {
	grid-column: 1 / 5;
	grid-row: 3;
	flex-direction: row;
	align-items: center;
	gap: 24px;
	padding: 20px 28px;
}

/* ICONS */
.app-icon {
	border-radius: 22.5%;
	object-fit: cover;
	flex-shrink: 0;
}

.hero-icon {
	width: 96px;
	height: 96px;
	margin-bottom: 32px;
}

.standard-icon {
	width: 64px;
	height: 64px;
	margin-bottom: 20px;
}

.zungzi-shot {
	width: 130px;
	height: auto;
	border-radius: 12px;
	object-fit: cover;
	flex-shrink: 0;
	margin-bottom: 20px;
	box-shadow: 0 10px 24px rgba(0,0,0,0.08);
}

.icon-placeholder {
	width: 64px;
	height: 64px;
	margin-bottom: 20px;
	border: 1px dashed rgba(0, 0, 0, 0.2);
	border-radius: 22.5%;
	display: flex;
	align-items: center;
	justify-content: center;
	text-align: center;
	color: #bbb;
	font-size: 0.55rem;
	font-weight: 700;
	letter-spacing: 0.05em;
	text-transform: uppercase;
	line-height: 1.4;
	flex-shrink: 0;
}

.mini {
	width: 40px;
	height: 40px;
}

.icons-row {
	display: flex;
	gap: 8px;
	flex-shrink: 0;
}

/* --- TYPOGRAPHY FIX --- */
.category {
	display: block;
	font-size: 0.7rem;
	font-weight: 700;

	/* The "Force Case" command */
	text-transform: none !important;

	letter-spacing: 0.08em;
	color: #999;
	margin-bottom: 6px;
}

h2 {
	margin: 0 0 8px 0;
	font-size: 1.1rem;
	font-weight: 600;
	letter-spacing: -0.01em;
	color: #111;
}

.sajeon h2 { font-size: 1.25rem; margin-bottom: 12px; }

p {
	margin: 0;
	font-size: 0.85rem;
	color: #777;
	line-height: 1.5;
}

.sajeon p { font-size: 0.9rem; }

.utilities h2 { margin-bottom: 2px; }
.utilities .category { margin-bottom: 0; order: 2; }

/* MOBILE */
@media (max-width: 900px) {
	.grid {
		grid-template-columns: 1fr;
		grid-template-rows: auto;
	}

	.card {
		grid-column: auto !important;
		grid-row: auto !important;
	}

	.utilities {
		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
	}

	.utilities .content {
		margin-top: 0;
	}
}
</style>
