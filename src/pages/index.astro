---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Language Apps & Free Lessons | san serif" description="Apple-native apps for learning Japanese, Korean, and Chinese, with free, ordered lessons in each language.">
	<main class="wrapper">
		<section class="home-intro" aria-labelledby="home-title">
			<div class="home-copy">
				<p class="eyebrow">INDEPENDENT LANGUAGE TOOLS</p>
				<h1 id="home-title">Built for the way you study.</h1>
				<p>Apple-native apps for reading, writing, and remembering Japanese, Korean, and Chinese.</p>
			</div>
			<aside class="learn-panel">
				<p class="eyebrow">STUDY FOR FREE</p>
				<h2>Learn the language behind the tools.</h2>
				<p>Follow short, ordered lessons with real examples.</p>
				<a href="/learn">Explore lessons →</a>
			</aside>
		</section>

		<section class="apps-intro" id="apps" aria-labelledby="apps-title">
			<h2 id="apps-title">The apps</h2>
			<p>Choose the tool that fits what you're learning.</p>
		</section>
		<section class="grid" aria-label="Language learning apps">

			{/* KAKU */}
			<a href="/portfolio/kaku" class="card kaku">
				<img src="/kaku-icon.png" alt="Kaku" class="app-icon standard-icon" />
				<div class="card-content">
					<h2>Kaku</h2>
					<span class="category">iOS, iPadOS, macOS / JP</span>
					<p>
						A Japanese notebook that keeps every tool exactly where you're writing. Highlight any word for instant offline definitions, insert the exact conjugated form you need, and translate the whole note when you want a second opinion.
					</p>
				</div>
			</a>

			{/* SAJEON */}
			<a href="/portfolio/sajeon" class="card sajeon">
				<img src="/sajeon-icon.png" alt="Sajeon" class="app-icon standard-icon" />
				<div class="card-content">
					<h2>Sajeon</h2>
					<span class="category">iOS, iPadOS, macOS / KR</span>
					<p>A native Korean dictionary built for deep immersion, with a clipboard reader that deconstructs complex sentences.</p>
				</div>
			</a>

			{/* TSUGI */}
			<a href="/portfolio/tsugi" class="card tsugi">
				<img src="/tsugi-icon.png" alt="Tsugi" class="app-icon standard-icon" />
				<div class="card-content">
					<h2>Tsugi</h2>
					<span class="category">iOS, iPadOS, macOS / JP</span>
					<p>Tsugi finds the next Japanese word you don't know (n+1), then teaches it in a real sentence just beyond your current level. Interactive furigana, audio, and adaptive review help each new word stick.</p>
				</div>
			</a>

			{/* YINPIN */}
			<a href="/portfolio/yinpin" class="card yinpin">
				<img src="/yinpin-icon.png" alt="Yinpin" class="app-icon standard-icon" />
				<div class="card-content">
					<h2>Yinpin</h2>
					<span class="category">iOS, iPadOS, macOS / CN</span>
					<p>A faster path to Chinese fluency through Pinyin. Master tone-accurate recall and pronunciation across the full HSK vocabulary, unlocking the ability to read, speak, and type any character without handwriting.</p>
				</div>
			</a>

			{/* TOKEITANGO */}
			<a href="/portfolio/tokeitango" class="card tokei">
				<img src="/tokeitango-icon.png?v=20261024" alt="TokeiTango" class="app-icon standard-icon" />
				<div class="card-content">
					<h2>TokeiTango</h2>
					<span class="category">watchOS / JP</span>
					<p>
						JLPT vocabulary and study sessions, reimagined for the wrist.
					</p>
				</div>
			</a>

			{/* EOHWI */}
			<a href="/portfolio/eohwi" class="card eohwi">
				<img src="/eohwi-icon.png?v=20261024" alt="Eohwi" class="app-icon standard-icon" />
				<div class="card-content">
					<h2>Eohwi</h2>
					<span class="category">watchOS / KR</span>
					<p>Master TOPIK vocabulary on the go, directly on your Apple Watch.</p>
				</div>
			</a>

			{/* ZUNGZI */}
			<a href="/portfolio/zungzi" class="card zungzi">
				<img src="/zungzi-icon.png?v=20261024" alt="Zungzi" class="app-icon standard-icon" />
				<div class="card-content">
					<h2>Zungzi</h2>
					<span class="category">watchOS / CN</span>
					<p>Conquer Chinese Hanzi from anywhere, one glance at a time.</p>
				</div>
			</a>

		</section>
	</main>
</Layout>

<style>
.home-intro { display: grid; grid-template-columns: 1.2fr .8fr; gap: 60px; align-items: center; max-width: 900px; margin: 0 auto 50px; padding: 0 0 42px; border-bottom: 1px solid #e9e9e9; }
.eyebrow { margin: 0 0 18px; color: #888; font-size: .7rem; font-weight: 700; letter-spacing: .15em; }
.home-copy h1 { margin: 0 0 18px; font-size: clamp(2.5rem, 4.5vw, 4.1rem); line-height: 1.07; letter-spacing: -.06em; font-weight: 650; }
.home-copy > p:not(.eyebrow) { max-width: 34rem; margin: 0; font-size: .97rem; line-height: 1.7; color: #666; }
.learn-panel { border: 1px solid #dedede; border-radius: 12px; padding: 26px; }
.learn-panel .eyebrow { margin-bottom: 15px; }
.learn-panel h2 { margin: 0 0 10px; font-size: 1.25rem; line-height: 1.3; letter-spacing: -.03em; }
.learn-panel p:not(.eyebrow) { margin: 0 0 20px; color: #777; font-size: .84rem; line-height: 1.55; }
.learn-panel a { color: #111; font-size: .85rem; font-weight: 650; text-decoration: none; }
.learn-panel a:hover { text-decoration: underline; text-underline-offset: 3px; }
.apps-intro { max-width: 900px; margin: 0 auto 22px; scroll-margin-top: 32px; }
.apps-intro h2 { margin: 0 0 5px; font-size: 1.35rem; letter-spacing: -.03em; }
.apps-intro > p:last-child { margin: 0; color: #777; font-size: .9rem; }
@media (max-width: 700px) { .home-intro { grid-template-columns: 1fr; gap: 28px; padding-bottom: 32px; margin-bottom: 34px; } }
.wrapper {
	padding-bottom: 100px;
}

.grid {
	display: grid;
	grid-template-columns: repeat(6, minmax(0, 1fr));
	gap: 12px;
	align-items: stretch;
	width: min(100%, 900px);
	margin: 0 auto;
}

/* BASE CARD */
.card {
	background: #ffffff;
	border: 1px solid rgba(0, 0, 0, 0.2);
	border-radius: 16px;
	padding: 20px;
	display: flex;
	flex-direction: column;
	justify-content: flex-start;
	text-decoration: none;
	min-width: 0;
	height: auto;
	width: 100%;
	max-width: none;
	box-sizing: border-box;
	cursor: pointer;
	transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.card-content {
	display: flex;
	flex-direction: column;
	margin-top: 0;
	gap: 4px;
}

.kaku .card-content,
.sajeon .card-content,
.tsugi .card-content,
.yinpin .card-content,
.tokei .card-content,
.eohwi .card-content,
.zungzi .card-content {
	flex: 1;
	width: auto;
	min-width: 0;
}

.kaku,
.sajeon,
.tsugi,
.yinpin,
.tokei,
.eohwi,
.zungzi {
	flex-direction: row;
	align-items: center;
	gap: 20px;
}

.tokei,
.eohwi,
.zungzi {
	gap: 16px;
}

/* HOVER STATES */
.card:hover {
	transform: translateY(-4px);
	border-color: rgba(0, 0, 0, 0.1);
	background: #ffffff;
}

/* --- BENTO PLACEMENT --- */
/* Row 1: 2 flagship apps side-by-side */
.kaku { grid-column: 1 / span 3; grid-row: 1; }
.sajeon { grid-column: 4 / span 3; grid-row: 1; }

/* Row 2: 2 multiplatform apps side-by-side */
.tsugi { grid-column: 1 / span 3; grid-row: 2; }
.yinpin { grid-column: 4 / span 3; grid-row: 2; }

/* Row 3: 3 watchOS companion apps side-by-side */
.tokei { grid-column: 1 / span 2; grid-row: 3; }
.eohwi { grid-column: 3 / span 2; grid-row: 3; }
.zungzi { grid-column: 5 / span 2; grid-row: 3; }

/* ICONS */
.app-icon {
	border-radius: 22.5%;
	object-fit: cover;
	flex-shrink: 0;
}

.kaku .standard-icon,
.sajeon .standard-icon,
.tsugi .standard-icon,
.yinpin .standard-icon {
	width: 88px;
	height: 88px;
	margin-bottom: 0;
}

.standard-icon {
	width: 72px;
	height: 72px;
	margin-bottom: 12px;
}

.tokei .standard-icon,
.eohwi .standard-icon,
.zungzi .standard-icon {
	width: 64px;
	height: 64px;
	margin-bottom: 0;
}

/* --- TYPOGRAPHY --- */
.category {
	display: block;
	font-size: 0.7rem;
	font-weight: 700;
	text-transform: none !important;
	letter-spacing: 0.08em;
	color: #999;
	margin-bottom: 6px;
}

h2 {
	margin: 0;
	font-size: 1.1rem;
	font-weight: 600;
	letter-spacing: -0.01em;
	color: #111;
}

p {
	margin: 0;
	font-size: 0.85rem;
	color: #777;
	line-height: 1.5;
}

/* TABLET */
@media (max-width: 900px) {
	.grid {
		grid-template-columns: repeat(6, minmax(0, 1fr));
	}

	.kaku { grid-column: 1 / span 6; }
	.sajeon { grid-column: 1 / span 6; }
	.tsugi { grid-column: 1 / span 3; }
	.yinpin { grid-column: 4 / span 3; }
	.tokei { grid-column: 1 / span 2; }
	.eohwi { grid-column: 3 / span 2; }
	.zungzi { grid-column: 5 / span 2; }
}

/* MOBILE */
@media (max-width: 650px) {
	.grid {
		grid-template-columns: 1fr;
		gap: 10px;
	}

	.card,
	.kaku,
	.sajeon,
	.tsugi,
	.yinpin,
	.tokei,
	.eohwi,
	.zungzi {
		grid-column: auto !important;
		grid-row: auto !important;
		min-height: auto;
	}

	.kaku,
	.sajeon,
	.tsugi,
	.yinpin,
	.tokei,
	.eohwi,
	.zungzi {
		flex-direction: row;
		align-items: center;
	}

	.kaku .card-content,
	.sajeon .card-content,
	.tsugi .card-content,
	.yinpin .card-content,
	.tokei .card-content,
	.eohwi .card-content,
	.zungzi .card-content {
		width: 100%;
	}
}
</style>
