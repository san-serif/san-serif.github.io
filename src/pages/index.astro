---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Language Apps, Lessons & Culture Notes | san serif" description="Apple-native apps for learning Japanese, Korean, and Chinese, with free lessons and culture notes.">
	<main class="wrapper">
		<section class="home-intro" aria-labelledby="home-title">
			<div class="home-copy">
				<p class="eyebrow">LANGUAGE APPS &amp; NOTES</p>
				<h1 id="home-title">Learn Japanese, Korean, and Chinese.</h1>
				<p>Explore native apps for reading, writing, and remembering what you learn, plus free lessons and culture notes.</p>
			</div>
			<aside class="learn-panel">
				<p class="eyebrow">STUDY FOR FREE</p>
				<h2>Learn the language behind the tools.</h2>
				<p>Follow short, ordered lessons with real examples.</p>
				<a href="/learn">Explore lessons →</a>
			</aside>
		</section>

		<section class="apps-intro" id="apps" aria-labelledby="apps-title">
			<h2 id="apps-title">Language learning</h2>
			<p>Different ways to study Japanese, Korean, and Chinese, from writing and reading to grammar and pronunciation.</p>
		</section>
		<div class="app-filters" role="group" aria-label="Filter apps by language" hidden>
            <button type="button" data-language="all" aria-pressed="true">All languages</button>
            <button type="button" data-language="japanese" aria-pressed="false">Japanese</button>
            <button type="button" data-language="korean" aria-pressed="false">Korean</button>
            <button type="button" data-language="chinese" aria-pressed="false">Chinese</button>
        </div>
        <p class="app-count" id="app-count" role="status" aria-live="polite"></p>
        <section class="grid" aria-label="Language learning apps">

			{/* KAKU */}
			<a data-app-language="japanese" href="/portfolio/kaku" class="card kaku">
				<img src="/kaku-icon.png" alt="Kaku" class="app-icon standard-icon" />
				<div class="card-content">
					<h2>Kaku</h2>
					<span class="category">iPhone, iPad & Mac · Japanese</span>
					<p>
						Write Japanese with an offline dictionary beside your note. Find conjugated forms, hear what you wrote, and get suggestions that help your grammar and wording.
					</p>
				</div>
			</a>

			{/* SAJEON */}
			<a data-app-language="korean" href="/portfolio/sajeon" class="card sajeon">
				<img src="/sajeon-icon.png" alt="Sajeon" class="app-icon standard-icon" />
				<div class="card-content">
					<h2>Sajeon</h2>
					<span class="category">iPhone, iPad & Mac · Korean</span>
					<p>Look up Korean words, read passages, and explore conjugations. Save words for flashcards and use sentence explanations to understand grammar in context.</p>
				</div>
			</a>

			{/* TSUGI */}
			<a data-app-language="japanese" href="/portfolio/tsugi" class="card tsugi">
				<img src="/tsugi-icon.png" alt="Tsugi" class="app-icon standard-icon" />
				<div class="card-content">
					<h2>Tsugi</h2>
					<span class="category">iPhone, iPad & Mac · Japanese</span>
					<p>Learn Japanese one sentence at a time, with each step introducing a new word. Audio, furigana, sentence breakdowns, and short grammar lessons help it all make sense.</p>
				</div>
			</a>

			{/* YINPIN */}
			<a data-app-language="chinese" href="/portfolio/yinpin" class="card yinpin">
				<img src="/yinpin-icon.png?v=20261103" alt="Yinpin" class="app-icon standard-icon" />
				<div class="card-content">
					<h2>Yinpin</h2>
					<span class="category">iPhone, iPad & Mac · Chinese</span>
					<p>Learn Chinese the easy way through Pinyin. Type readings from memory, then connect them to characters, real sentences, and grammar as you go.</p>
				</div>
			</a>

			{/* TOKEITANGO */}
			<a data-app-language="japanese" href="/portfolio/tokeitango" class="card tokei">
				<img src="/tokeitango-icon.png?v=20261024" alt="TokeiTango" class="app-icon standard-icon" />
				<div class="card-content">
					<h2>TokeiTango</h2>
					<span class="category">Apple Watch · Japanese</span>
					<p>
						Learn Japanese words through examples, grammar and conjugations on your Watch.
					</p>
				</div>
			</a>

			{/* EOHWI */}
			<a data-app-language="korean" href="/portfolio/eohwi" class="card eohwi">
				<img src="/eohwi-icon.png?v=20261024" alt="Eohwi" class="app-icon standard-icon" />
				<div class="card-content">
					<h2>Eohwi</h2>
					<span class="category">Apple Watch · Korean</span>
					<p>TOPIK vocabulary on your Watch, with speech-level examples, conjugations and etymology.</p>
				</div>
			</a>

			{/* ZUNGZI */}
			<a data-app-language="chinese" href="/portfolio/zungzi" class="card zungzi">
				<img src="/zungzi-icon.png?v=20261031" alt="Zungzi" class="app-icon standard-icon" />
				<div class="card-content">
					<h2>Zungzi</h2>
					<span class="category">Apple Watch · Chinese</span>
					<p>Study Chinese in Mandarin or Cantonese, with words and sentences on your Watch.</p>
				</div>
			</a>

		</section>

		<section class="developer-section" aria-labelledby="developer-title">
			<div class="apps-intro">
				<h2 id="developer-title">For developers</h2>
				<p>Native Mac tools for building apps and making sense of the business behind them.</p>
			</div>
			<div class="developer-grid">
				<a href="/portfolio/kodeu" class="card developer-card">
					<img src="/kodeu-icon.png" alt="Kodeu icon" class="app-icon standard-icon" />
					<div class="card-content">
						<h3>Kodeu</h3>
						<span class="category">Mac · Code editor</span>
						<p>A beautiful native editor for code and Markdown, with built-in themes, ligature fonts, and a clean workspace from the first launch.</p>
					</div>
				</a>
				<a href="/portfolio/reji" class="card developer-card">
					<img src="/reji-icon.png" alt="Reji icon" class="app-icon standard-icon" />
					<div class="card-content">
						<h3>Reji</h3>
						<span class="category">Mac · App business</span>
						<p>See how your apps perform across products, countries, and dates, with sales, downloads, and pricing in one native Mac workspace.</p>
					</div>
				</a>
			</div>
		</section>
	</main>
</Layout>

<script>
  const filters = document.querySelector<HTMLElement>('.app-filters');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-app-language]')];
  const count = document.getElementById('app-count');
  if (filters) {
    filters.hidden = false;
    filters.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-language]');
      if (!button) return;
      for (const control of filters.querySelectorAll('button')) control.setAttribute('aria-pressed', String(control === button));
      const language = button.dataset.language;
      for (const card of cards) card.hidden = language !== 'all' && card.dataset.appLanguage !== language;
      document.querySelector('.grid')?.classList.toggle('is-filtered', language !== 'all');
      const total = cards.filter(card => !card.hidden).length;
      if (count) count.textContent = `${total} apps${language === 'all' ? '' : ` for ${button.textContent}`}`;
    });
  }
</script>

<style>
.app-filters { display: flex; flex-wrap: wrap; gap: 8px; max-width: 900px; margin: 0 auto; }
.app-filters[hidden], .card[hidden] { display: none; }
.app-filters button { font: inherit; font-size: .8rem; padding: 9px 14px; border: 1px solid #ddd; border-radius: 999px; background: #fff; color: #555; cursor: pointer; }
.app-filters button[aria-pressed="true"] { background: #111; color: #fff; border-color: #111; }
.app-filters button:focus-visible { outline: 2px solid #111; outline-offset: 3px; }
.app-count { max-width: 900px; margin: 10px auto 18px; font-size: .76rem; color: #666; }
.grid.is-filtered { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.grid.is-filtered .card { grid-column: auto; grid-row: auto; }
@media (max-width: 650px) { .grid.is-filtered { grid-template-columns: 1fr; } }

.home-intro { display: grid; grid-template-columns: 1.2fr .8fr; gap: 60px; align-items: center; max-width: 900px; margin: 0 auto 50px; padding: 0 0 42px; border-bottom: 1px solid #e9e9e9; }
.eyebrow { margin: 0 0 18px; color: #888; font-size: .7rem; font-weight: 700; letter-spacing: .15em; }
.home-copy h1 { margin: 0 0 18px; font-size: clamp(2.5rem, 4.5vw, 4.1rem); line-height: 1.07; letter-spacing: -.06em; font-weight: 650; }
.home-copy > p:not(.eyebrow) { max-width: 34rem; margin: 0; font-size: .97rem; line-height: 1.7; color: #666; }
.learn-panel { border: 1px solid #dedede; border-radius: 12px; padding: 26px; }
.learn-panel .eyebrow { margin-bottom: 15px; }
.learn-panel h2 { margin: 0 0 10px; font-size: 1.25rem; line-height: 1.3; letter-spacing: -.03em; }
.learn-panel p:not(.eyebrow) { margin: 0 0 20px; color: #777; font-size: .84rem; line-height: 1.55; }
.learn-panel a { color: #111; font-size: .85rem; font-weight: 650; text-decoration: none; }
.learn-panel a:hover { text-decoration: underline; text-underline-offset: 3px; }
.apps-intro { max-width: 900px; margin: 0 auto 22px; scroll-margin-top: 32px; }
.apps-intro h2 { margin: 0 0 5px; font-size: 1.35rem; letter-spacing: -.03em; }
.apps-intro > p:last-child { margin: 0; color: #777; font-size: .9rem; }
.developer-section { max-width: 900px; margin: 58px auto 0; padding-top: 36px; border-top: 1px solid #e9e9e9; }
.developer-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.card.developer-card { flex-direction: row; align-items: center; gap: 20px; }
.developer-card .standard-icon { width: 88px; height: 88px; margin: 0; }
.developer-card h3 { margin: 0; font-size: 1.1rem; font-weight: 600; letter-spacing: -.01em; color: #111; }
.developer-card .card-content { flex: 1; }
@media (max-width: 700px) { .home-intro { grid-template-columns: 1fr; gap: 28px; padding-bottom: 32px; margin-bottom: 34px; } }
.wrapper {
	padding-bottom: 100px;
}

.grid {
	display: grid;
	grid-template-columns: repeat(6, minmax(0, 1fr));
	gap: 12px;
	align-items: stretch;
	width: min(100%, 900px);
	margin: 0 auto;
}

/* BASE CARD */
.card {
	background: #ffffff;
	border: 1px solid rgba(0, 0, 0, 0.2);
	border-radius: 16px;
	padding: 20px;
	display: flex;
	flex-direction: column;
	justify-content: flex-start;
	text-decoration: none;
	min-width: 0;
	height: auto;
	width: 100%;
	max-width: none;
	box-sizing: border-box;
	cursor: pointer;
	transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.card-content {
	display: flex;
	flex-direction: column;
	margin-top: 0;
	gap: 4px;
}

.kaku .card-content,
.sajeon .card-content,
.tsugi .card-content,
.yinpin .card-content,
.tokei .card-content,
.eohwi .card-content,
.zungzi .card-content {
	flex: 1;
	width: auto;
	min-width: 0;
}

.kaku,
.sajeon,
.tsugi,
.yinpin,
.tokei,
.eohwi,
.zungzi {
	flex-direction: row;
	align-items: center;
	gap: 20px;
}

.tokei,
.eohwi,
.zungzi {
	gap: 16px;
}

/* HOVER STATES */
.card:hover {
	transform: translateY(-4px);
	border-color: rgba(0, 0, 0, 0.1);
	background: #ffffff;
}

/* --- BENTO PLACEMENT --- */
/* Row 1: 2 flagship apps side-by-side */
.kaku { grid-column: 1 / span 3; grid-row: 1; }
.sajeon { grid-column: 4 / span 3; grid-row: 1; }

/* Row 2: 2 multiplatform apps side-by-side */
.tsugi { grid-column: 1 / span 3; grid-row: 2; }
.yinpin { grid-column: 4 / span 3; grid-row: 2; }

/* Row 3: 3 watchOS companion apps side-by-side */
.tokei { grid-column: 1 / span 2; grid-row: 3; }
.eohwi { grid-column: 3 / span 2; grid-row: 3; }
.zungzi { grid-column: 5 / span 2; grid-row: 3; }

/* ICONS */
.app-icon {
	border-radius: 22.5%;
	object-fit: cover;
	flex-shrink: 0;
}

.kaku .standard-icon,
.sajeon .standard-icon,
.tsugi .standard-icon,
.yinpin .standard-icon {
	width: 88px;
	height: 88px;
	margin-bottom: 0;
}

.standard-icon {
	width: 72px;
	height: 72px;
	margin-bottom: 12px;
}

.tokei .standard-icon,
.eohwi .standard-icon,
.zungzi .standard-icon {
	width: 64px;
	height: 64px;
	margin-bottom: 0;
	border-radius: 50%;
}

/* --- TYPOGRAPHY --- */
.category {
	display: block;
	font-size: 0.7rem;
	font-weight: 700;
	text-transform: none !important;
	letter-spacing: 0.08em;
	color: #999;
	margin-bottom: 6px;
}

h2 {
	margin: 0;
	font-size: 1.1rem;
	font-weight: 600;
	letter-spacing: -0.01em;
	color: #111;
}

p {
	margin: 0;
	font-size: 0.85rem;
	color: #777;
	line-height: 1.5;
}

/* TABLET */
@media (max-width: 900px) {
	.grid {
		grid-template-columns: repeat(6, minmax(0, 1fr));
	}

	.kaku { grid-column: 1 / span 6; }
	.sajeon { grid-column: 1 / span 6; }
	.tsugi { grid-column: 1 / span 3; }
	.yinpin { grid-column: 4 / span 3; }
	.tokei { grid-column: 1 / span 2; }
	.eohwi { grid-column: 3 / span 2; }
	.zungzi { grid-column: 5 / span 2; }
}

/* MOBILE */
@media (max-width: 650px) {
	.developer-grid { grid-template-columns: 1fr; }
	.grid {
		grid-template-columns: 1fr;
		gap: 10px;
	}

	.card,
	.kaku,
	.sajeon,
	.tsugi,
	.yinpin,
	.tokei,
	.eohwi,
	.zungzi {
		grid-column: auto !important;
		grid-row: auto !important;
		min-height: auto;
	}

	.kaku,
	.sajeon,
	.tsugi,
	.yinpin,
	.tokei,
	.eohwi,
	.zungzi {
		flex-direction: row;
		align-items: center;
	}

	.kaku .card-content,
	.sajeon .card-content,
	.tsugi .card-content,
	.yinpin .card-content,
	.tokei .card-content,
	.eohwi .card-content,
	.zungzi .card-content {
		width: 100%;
	}
}
</style>
