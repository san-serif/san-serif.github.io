---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Language Apps & Culture Notes | san serif" description="Sajeon, Kaku, TokeiTango, Eohwi, Zungzi, Yinpin, Tsugi, and more: Apple-native apps for learning Korean, Japanese, and Chinese, built by an independent studio focused on minimal friction and long-term retention.">
	<main class="wrapper">

		<div class="tier-label">iPhone &amp; iPad</div>
		<section class="grid phone-grid">

			{/* SAJEON */}
			<a href="/portfolio/sajeon" class="card sajeon">
				<img src="/sajeon-icon.png" alt="Sajeon" class="app-icon hero-icon" />
				<div class="card-content">
					<span class="category">iOS, iPadOS, macOS / KR</span>
					<h2>Sajeon</h2>
					<p>
						A native Korean dictionary built for deep immersion. Beyond rapid search, Sajeon features a powerful clipboard reader to deconstruct complex sentences for translation and shadow reading. Curate your progress with custom word lists and extensive catalogue of vocabulary, all within a distilled interface that stays out of your way.
					</p>
				</div>
			</a>

			{/* KAKU */}
			<a href="/portfolio/kaku" class="card kaku placeholder-card">
				<div class="icon-placeholder">Icon<br>pending</div>
				<div class="card-content">
					<span class="category">iOS, iPadOS, macOS / JP</span>
					<h2>Kaku</h2>
					<p>A Japanese notebook built to keep you writing, not switching apps. Highlight any word for instant offline definitions, insert the exact conjugated form you need, and read your notes back aloud.</p>
				</div>
			</a>

			{/* TSUGI */}
			<a href="/portfolio/tsugi" class="card tsugi placeholder-card">
				<div class="icon-placeholder">Icon<br>pending</div>
				<div class="card-content">
					<span class="category">iOS, iPadOS / JP</span>
					<h2>Tsugi</h2>
					<p>AI-powered sentence mining for learners who've outgrown basic flashcard apps. Feed Tsugi any native sentence and it isolates the exact grammar or vocabulary you don't know yet, building a personalized SRS deck as you go.</p>
				</div>
			</a>

			{/* YINPIN */}
			<a href="/portfolio/yinpin" class="card yinpin placeholder-card">
				<div class="icon-placeholder">Icon<br>pending</div>
				<div class="card-content">
					<span class="category">iOS, iPadOS / CN</span>
					<h2>Yinpin</h2>
					<p>Full HSK vocabulary, one word at a time, each paired with its own example sentence. Type the romanization from memory and check it against the correct pinyin and tone marks, while spaced repetition adapts to what you actually know.</p>
				</div>
			</a>

		</section>

		<div class="tier-label second">Apple Watch</div>
		<section class="grid watch-grid">

			{/* TOKEITANGO */}
			<a href="/portfolio/tokeitango" class="card tokei">
				<img src="/tokeitango-icon.png" alt="tokeitango" class="app-icon standard-icon" />
				<div class="card-content">
					<span class="category">watchOS / JP</span>
					<h2>TokeiTango</h2>
					<p>
						JLPT vocabulary and study sessions, reimagined for the wrist. Discreet, haptic-driven reviews designed for immersion on the go.
					</p>
				</div>
			</a>

			{/* EOHWI */}
			<a href="/portfolio/eohwi" class="card eohwi">
				<img src="/eohwi-icon.png" alt="Eohwi" class="app-icon standard-icon" />
				<div class="card-content">
					<span class="category">watchOS / KR</span>
					<h2>Eohwi</h2>
					<p>Master TOPIK vocabulary on the go. Bite-sized Korean flashcards and smart spaced repetition directly on your Apple Watch.</p>
				</div>
			</a>

			{/* ZUNGZI */}
			<a href="/portfolio/zungzi" class="card zungzi">
				<img src="/images/zungzi-hsk.png" alt="Zungzi" class="zungzi-shot" />
				<div class="card-content">
					<span class="category">watchOS / CN</span>
					<h2>Zungzi</h2>
					<p>Conquer Chinese Hanzi from anywhere. Practice HSK characters with quick-glance reviews and Mandarin/Cantonese audio.</p>
				</div>
			</a>

		</section>

		{/* UTILITIES */}
		<a href="https://apps.apple.com/us/app-bundle/asian-language-menubar/id1793885201?mt=12" class="utilities-strip">
			<div class="icons-row">
				<img src="/jbar-icon.png" alt="JBar" class="app-icon mini" />
				<img src="/kbar-icon.png" alt="KBar" class="app-icon mini" />
				<img src="/cbar-icon.png" alt="CBar" class="app-icon mini" />
			</div>
			<div class="content">
				<h2>JBar, KBar &amp; CBar</h2>
				<p>Minimal menubar utilities that keep your target language seamlessly integrated into your daily workflow. macOS / JP, KR, CN</p>
			</div>
		</a>

	</main>
</Layout>

<style>
.wrapper {
	padding-bottom: 100px;
}

.tier-label {
	font-size: 0.7rem;
	font-weight: 800;
	letter-spacing: 0.1em;
	text-transform: uppercase;
	color: #bbb;
	margin: 0 0 12px 4px;
}
.tier-label.second { margin-top: 40px; }

.grid {
	display: grid;
	gap: 20px;
}

.phone-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.watch-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }

/* BASE CARD */
.card {
	background: #ffffff;
	border: 1px solid rgba(0, 0, 0, 0.2);
	border-radius: 32px;
	padding: 32px;
	display: flex;
	flex-direction: column;
	text-decoration: none;
	min-width: 0;
	cursor: pointer;
	transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.card-content, .content {
	display: flex;
	flex-direction: column;
	margin-top: auto;
}

/* HOVER STATES */
.card:hover, .utilities-strip:hover {
	transform: translateY(-6px);
	border-color: rgba(0, 0, 0, 0.1);
	background: #ffffff;
}

.sajeon { grid-column: 1; grid-row: 1 / span 2; }
.kaku, .tsugi, .yinpin { grid-row: 1; }

/* ICONS */
.app-icon {
	border-radius: 22.5%;
	object-fit: cover;
	flex-shrink: 0;
}

.hero-icon {
	width: 96px;
	height: 96px;
	margin-bottom: 32px;
}

.standard-icon {
	width: 72px;
	height: 72px;
	margin-bottom: 24px;
}

.zungzi-shot {
	width: 150px;
	height: auto;
	border-radius: 14px;
	object-fit: cover;
	flex-shrink: 0;
	margin-bottom: 24px;
	box-shadow: 0 10px 24px rgba(0,0,0,0.08);
}

.icon-placeholder {
	width: 72px;
	height: 72px;
	margin-bottom: 24px;
	border: 1px dashed rgba(0, 0, 0, 0.2);
	border-radius: 22.5%;
	display: flex;
	align-items: center;
	justify-content: center;
	text-align: center;
	color: #bbb;
	font-size: 0.6rem;
	font-weight: 700;
	letter-spacing: 0.05em;
	text-transform: uppercase;
	line-height: 1.4;
	flex-shrink: 0;
}

.mini {
	width: 54px;
	height: 54px;
}

.icons-row {
	display: flex;
	gap: 16px;
	margin-bottom: 24px;
}

.utilities-strip {
	margin-top: 20px;
	display: flex;
	align-items: center;
	gap: 40px;
	background: #ffffff;
	border: 1px solid rgba(0, 0, 0, 0.2);
	border-radius: 32px;
	padding: 32px;
	text-decoration: none;
	transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* --- TYPOGRAPHY FIX --- */
.category {
	display: block;
	font-size: 0.725rem;
	font-weight: 700;

	/* The "Force Case" command */
	text-transform: none !important;

	letter-spacing: 0.08em;
	color: #999;
	margin-bottom: 8px;
}

h2 {
	margin: 0 0 12px 0;
	font-size: 1.25rem;
	font-weight: 600;
	letter-spacing: -0.01em;
	color: #111;
}

p {
	margin: 0;
	font-size: 0.9rem;
	color: #777;
	line-height: 1.5;
}

/* MOBILE */
@media (max-width: 900px) {
	.phone-grid, .watch-grid {
		grid-template-columns: 1fr;
	}

	.card {
		grid-column: auto !important;
		grid-row: auto !important;
	}

	.utilities-strip {
		flex-direction: column;
		align-items: flex-start;
		gap: 24px;
	}

	.utilities-strip .content {
		margin-top: 0;
	}
}
</style>
