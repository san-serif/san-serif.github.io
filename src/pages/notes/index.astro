---
/* LESSON LIBRARY - san serif
  - Language courses read as a syllabus in curriculum order.
  - Editorial index styling: no emoji, no "Course" label. Colour appears
    once per level group, not smeared across every row — earned structure,
    not decoration. Hairline rules lifted from about.astro.
  - Progressive-disclosure filter tags: selecting a language reveals that
    language's level pills inline; deselecting collapses them and clears
    anything active inside.
  - Dynamic Multi-Tag Filtering (client-side, AND semantics)
  - Live text search (client-side)
*/
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { LEVEL_ORDER, isTangent, groupByLevel, parseTitle } from '../../lib/notesGrouping';
import { chineseTitleCue } from '../../lib/chineseTitleCue';

const notes = await getCollection('notes');

const japaneseNotes = notes.filter(n => n.data.category.includes('JAPANESE') && !isTangent(n));
const koreanNotes = notes.filter(n => n.data.category.includes('KOREAN') && !isTangent(n));
const chineseNotes = notes.filter(n => n.data.category.includes('CHINESE') && !isTangent(n));
// Matches VocabTable's own collapse threshold elsewhere on the site — same
// "Show all N ↓" pattern, not a new interaction. Only applies to the
// default, unfiltered view; any active search or tag filter shows every
// match regardless of this count.
const VISIBLE_COUNT = 12;

const japaneseGroups = groupByLevel(japaneseNotes);
const koreanGroups = groupByLevel(koreanNotes);
const chineseGroups = groupByLevel(chineseNotes);

const allCategories = [...new Set(notes.flatMap(n => n.data.level ? [...n.data.category, n.data.level] : n.data.category))];
const has = (tag: string) => allCategories.includes(tag);

// "JLPT" only gets prefixed on the filter buttons, where N5 sits directly
// next to TOPIK I and needs disambiguating. Inside a section already headed
// "Japanese 日本語", a bare "N5" is unambiguous, so the in-page level labels
// skip the prefix.
const filterLevelLabel = (level: string) => level.startsWith('N') ? `JLPT ${level}` : level;

const LEVEL_CLASSES: Record<string, string> = {
	'N5': 'level-n5', 'N4': 'level-n4', 'N3': 'level-n3', 'N2': 'level-n2', 'N1': 'level-n1',
	'TOPIK I': 'level-topik1', 'TOPIK II': 'level-topik2',
	'HSK 1': 'level-hsk1', 'HSK 2': 'level-hsk2', 'HSK 3': 'level-hsk3', 'HSK 4': 'level-hsk4',
	'HSK 5': 'level-hsk5', 'HSK 6': 'level-hsk6', 'HSK 7–9': 'level-hsk79',
};
const levelClass = (level: string) => LEVEL_CLASSES[level] ?? '';

const rowCategory = (n: typeof notes[number]) =>
  (n.data.level ? [...n.data.category, n.data.level] : n.data.category).join(',').toLowerCase();
const rowSearch = (n: typeof notes[number]) =>
  `${n.data.title} ${n.data.description ?? ''} ${chineseTitleCue(n) ?? ''}`.toLowerCase();
---

<Layout title="Lesson Library | san serif" description="Search free Korean, Japanese, and Chinese grammar lessons, with real example sentences and useful vocabulary.">
	<main class="wrapper">

		<header class="page-header">
			<h1>Lesson library</h1>
			<p class="page-subtitle">
				Search the complete collection, or follow a course from the beginning.
			</p>
			<nav class="course-shortcuts" aria-label="Language courses">
				<a href="/learn/japanese">Japanese course →</a>
				<a href="/learn/korean">Korean course →</a>
				<a href="/learn/chinese">Chinese course →</a>
			</nav>

			<div class="search-row">
				<input type="text" class="search-input" id="search-input" placeholder="Search notes by title or description…" />
			</div>

			<div class="controls-container">
				<span class="control-label">FILTER</span>

				<div class="tag-cloud">
					{has('JAPANESE') && <button class="filter-tag parent" data-tag="japanese" data-children="children-japanese">JAPANESE</button>}
					{has('KOREAN') && <button class="filter-tag parent" data-tag="korean" data-children="children-korean">KOREAN</button>}
					{has('CHINESE') && <button class="filter-tag parent" data-tag="chinese" data-children="children-chinese">CHINESE</button>}
				</div>

				{has('JAPANESE') && (LEVEL_ORDER.some(l => l.startsWith('N') && has(l))) && (
					<div class="tag-cloud filter-children" id="children-japanese" hidden>
						{LEVEL_ORDER.filter(l => l.startsWith('N') && has(l)).map(lvl => (
							<button class="filter-tag child" data-tag={lvl.toLowerCase()}>{filterLevelLabel(lvl)}</button>
						))}
					</div>
				)}

				{has('KOREAN') && (has('TOPIK I') || has('TOPIK II')) && (
					<div class="tag-cloud filter-children" id="children-korean" hidden>
						{LEVEL_ORDER.filter(l => l.startsWith('TOPIK') && has(l)).map(lvl => (
							<button class="filter-tag child" data-tag={lvl.toLowerCase()}>{filterLevelLabel(lvl)}</button>
						))}
					</div>
				)}

				{has('CHINESE') && LEVEL_ORDER.some(l => l.startsWith('HSK') && has(l)) && (
					<div class="tag-cloud filter-children" id="children-chinese" hidden>
						{LEVEL_ORDER.filter(l => l.startsWith('HSK') && has(l)).map(lvl => (
							<button class="filter-tag child" data-tag={lvl.toLowerCase()}>{lvl}</button>
						))}
					</div>
				)}
			</div>
		</header>

		<section class="idx-section" id="section-japanese">
			<div class="idx-lang-header">
				<h2 class="idx-lang-title">Japanese <span class="idx-lang-native">日本語</span></h2>
				<div class="idx-lang-meta" id="meta-japanese">{japaneseNotes.length} notes · {japaneseGroups.map(g => g.level).join(' → ')}</div>
			</div>
			{japaneseGroups.map(group => (
				<div class="idx-level-group" data-level-group={group.level.toLowerCase()}>
					<span class={`idx-level-label ${levelClass(group.level)}`}>{group.level}</span>
					<div class="idx-list">
						{group.notes.map((note, i) => {
							const { main, detail } = parseTitle(note.data.title);
							return (
								<a
									href={`/notes/${note.slug || note.id}`}
									class={`idx-row ${i >= VISIBLE_COUNT ? 'idx-row-extra' : ''}`}
									data-category={rowCategory(note)}
									data-search={rowSearch(note)}
								>
									<span class="idx-title">{main}{detail && <span class="idx-title-detail"> {detail}</span>}</span>
								</a>
							);
						})}
					</div>
					{group.notes.length > VISIBLE_COUNT && (
						<button class="idx-show-toggle" data-total={group.notes.length} onclick="toggleLevelGroup(this)">
							Show all {group.notes.length} →
						</button>
					)}
				</div>
			))}
		</section>

		<div class="idx-divider" id="divider-japanese-korean" data-before="section-japanese" data-after="section-korean"></div>

		<section class="idx-section" id="section-korean">
			<div class="idx-lang-header">
				<h2 class="idx-lang-title">Korean <span class="idx-lang-native">한국어</span></h2>
				<div class="idx-lang-meta" id="meta-korean">{koreanNotes.length} notes · {koreanGroups.map(g => g.level).join(' → ')}</div>
			</div>
			{koreanGroups.map(group => (
				<div class="idx-level-group" data-level-group={group.level.toLowerCase()}>
					<span class={`idx-level-label ${levelClass(group.level)}`}>{group.level}</span>
					<div class="idx-list">
						{group.notes.map((note, i) => {
							const { main, detail } = parseTitle(note.data.title);
							return (
								<a
									href={`/notes/${note.slug || note.id}`}
									class={`idx-row ${i >= VISIBLE_COUNT ? 'idx-row-extra' : ''}`}
									data-category={rowCategory(note)}
									data-search={rowSearch(note)}
								>
									<span class="idx-title">{main}{detail && <span class="idx-title-detail"> {detail}</span>}</span>
								</a>
							);
						})}
					</div>
					{group.notes.length > VISIBLE_COUNT && (
						<button class="idx-show-toggle" data-total={group.notes.length} onclick="toggleLevelGroup(this)">
							Show all {group.notes.length} →
						</button>
					)}
				</div>
			))}
		</section>

		<div class="idx-divider" id="divider-korean-chinese" data-before="section-korean" data-after="section-chinese"></div>

		<section class="idx-section" id="section-chinese">
			<div class="idx-lang-header">
				<h2 class="idx-lang-title">Chinese <span class="idx-lang-native">中文</span></h2>
				<div class="idx-lang-meta" id="meta-chinese">{chineseNotes.length} notes · {chineseGroups.map(g => g.level).join(' → ')}</div>
			</div>
			{chineseGroups.map(group => (
				<div class="idx-level-group" data-level-group={group.level.toLowerCase()}>
					<span class={`idx-level-label ${levelClass(group.level)}`}>{group.level}</span>
					<div class="idx-list">
						{group.notes.map((note, i) => {
							const { main, detail } = parseTitle(note.data.title);
						const cue = chineseTitleCue(note);
							return (
								<a href={`/notes/${note.slug || note.id}`} class={`idx-row ${i >= VISIBLE_COUNT ? 'idx-row-extra' : ''}`} data-category={rowCategory(note)} data-search={rowSearch(note)}>
								<span class="idx-title">{main}{detail ? <span class="idx-title-detail"> {detail}</span> : cue && <span class="idx-title-detail" lang="zh"> 例 · {cue}</span>}</span>
								</a>
							);
						})}
					</div>
					{group.notes.length > VISIBLE_COUNT && <button class="idx-show-toggle" data-total={group.notes.length} onclick="toggleLevelGroup(this)">Show all {group.notes.length} →</button>}
				</div>
			))}
		</section>

		<div class="empty-state" id="empty-state">No notes match this combination. Try clearing a tag or the search.</div>

	</main>
</Layout>

<script is:inline>
	const searchInput = document.getElementById('search-input');
	const emptyState = document.getElementById('empty-state');
	const idxRows = Array.from(document.querySelectorAll('.idx-row'));
	const allRows = idxRows;
	const levelGroups = Array.from(document.querySelectorAll('.idx-level-group'));
	const sections = Array.from(document.querySelectorAll('.idx-section'));
	const dividers = Array.from(document.querySelectorAll('.idx-divider'));
	let activeTags = new Set();

	document.querySelectorAll('.filter-tag').forEach(btn => {
		btn.addEventListener('click', () => {
			const tag = btn.getAttribute('data-tag');
			const wasActive = activeTags.has(tag);

			if (wasActive) {
				activeTags.delete(tag);
				btn.classList.remove('active');
			} else {
				activeTags.add(tag);
				btn.classList.add('active');
			}

			// Parent tags (JAPANESE, KOREAN) reveal their level pills only
			// once selected — TOPIK options have no reason to be on screen
			// while nobody's looking at Korean content, and vice versa.
			// Deselecting the parent collapses its levels back and clears
			// whichever ones were active, so nothing keeps filtering from
			// behind a hidden control.
			const childrenId = btn.getAttribute('data-children');
			if (childrenId) {
				const childrenEl = document.getElementById(childrenId);
				const nowActive = !wasActive;
				childrenEl.hidden = !nowActive;
				if (!nowActive) {
					childrenEl.querySelectorAll('.filter-tag.child.active').forEach(child => {
						activeTags.delete(child.getAttribute('data-tag'));
						child.classList.remove('active');
					});
				}
			}

			applyFilters();
		});
	});

	searchInput.addEventListener('input', applyFilters);

	// "Show all N →" per level-group, same collapse pattern VocabTable
	// already uses elsewhere on the site. Expanding a group persists for
	// the rest of the visit — it doesn't re-collapse just because a filter
	// got cleared.
	window.toggleLevelGroup = function (btn) {
		const group = btn.closest('.idx-level-group');
		const isOpen = group.classList.toggle('group-expanded');
		btn.textContent = isOpen ? 'Show fewer ↑' : `Show all ${btn.dataset.total} →`;
		applyFilters();
	};

	function applyFilters() {
		const query = searchInput.value.trim().toLowerCase();
		const filtersActive = activeTags.size > 0 || query !== '';
		let visibleTotal = 0;

		allRows.forEach(row => {
			const rowTags = row.getAttribute('data-category').split(',');
			const matchesTags = [...activeTags].every(t => rowTags.includes(t));
			const matchesSearch = query === '' || row.getAttribute('data-search').includes(query);
			// "filtered-out" tracks whether a row belongs in this section at
			// all — used for the meta count, which should keep describing
			// the true total even while truncation hides most of it. "hidden"
			// is the actual display toggle: filtered out OR (truncated and
			// its group hasn't been expanded).
			const matchesFilter = matchesTags && matchesSearch;
			row.classList.toggle('filtered-out', !matchesFilter);

			const group = row.closest('.idx-level-group');
			const isExtra = row.classList.contains('idx-row-extra');
			const groupExpanded = !group || group.classList.contains('group-expanded');
			const truncated = !filtersActive && isExtra && !groupExpanded;
			const isVisible = matchesFilter && !truncated;
			row.classList.toggle('hidden', !isVisible);
			if (isVisible) visibleTotal++;
		});

		document.querySelectorAll('.idx-show-toggle').forEach(btn => {
			btn.classList.toggle('hidden', filtersActive);
		});

		// Collapse level-groups and whole sections once nothing inside them
		// matches the filter, so readers don't hit an orphaned "N5" header
		// sitting above nothing. Based on filter match, not truncation — a
		// group with all its extra rows collapsed still has real matches.
		levelGroups.forEach(group => {
			const hasMatch = Array.from(group.querySelectorAll('.idx-row')).some(r => !r.classList.contains('filtered-out'));
			group.classList.toggle('hidden', !hasMatch);
		});

		sections.forEach(section => {
			const hasMatch = Array.from(section.querySelectorAll('.idx-row')).some(r => !r.classList.contains('filtered-out'));
			section.classList.toggle('hidden', !hasMatch);
		});

		// A divider is only doing its job if there's a visible section on
		// both sides of it — otherwise it's just a stray line sitting above
		// or below empty space.
		dividers.forEach(divider => {
			const before = document.getElementById(divider.dataset.before);
			const after = document.getElementById(divider.dataset.after);
			const bothVisible = before && after && !before.classList.contains('hidden') && !after.classList.contains('hidden');
			divider.classList.toggle('hidden', !bothVisible);
		});

		updateMeta();
		emptyState.classList.toggle('visible', visibleTotal === 0);
	}

	// The "114 notes · N5 → N4" line under each language heading is static
	// server-rendered text — it has to be recomputed here on every filter
	// change, or it keeps describing the unfiltered set while the list below
	// it shows something else entirely.
	function updateMeta() {
		const japaneseMeta = document.getElementById('meta-japanese');
		const koreanMeta = document.getElementById('meta-korean');
		const chineseMeta = document.getElementById('meta-chinese');

		// Counts by filter match, not DOM visibility — truncation hides rows
		// on screen without removing them from what this section "contains",
		// so the count shouldn't drop just because a group is collapsed.
		function describe(sectionEl) {
			const matchingRows = Array.from(sectionEl.querySelectorAll('.idx-row')).filter(r => !r.classList.contains('filtered-out'));
			const matchingLevels = Array.from(sectionEl.querySelectorAll('.idx-level-group'))
				.filter(g => !g.classList.contains('hidden'))
				.map(g => g.getAttribute('data-level-group').toUpperCase());
			const levelText = matchingLevels.length ? ` · ${matchingLevels.join(' → ')}` : '';
			return `${matchingRows.length} note${matchingRows.length === 1 ? '' : 's'}${levelText}`;
		}

		japaneseMeta.textContent = describe(document.getElementById('section-japanese'));
		koreanMeta.textContent = describe(document.getElementById('section-korean'));
		chineseMeta.textContent = describe(document.getElementById('section-chinese'));
	}

	// Establishes the truncated default view on load — without this, every
	// row (including the ones past VISIBLE_COUNT) would render fully open
	// until the first filter/search interaction.
	applyFilters();
</script>

<style>
	.course-shortcuts { display: flex; flex-wrap: wrap; gap: 10px 22px; margin: 24px 0 34px; }
	.course-shortcuts a { color: #111; font-size: .82rem; font-weight: 600; text-decoration: none; }
	.course-shortcuts a:hover { text-decoration: underline; text-underline-offset: 3px; }
	.wrapper {
		max-width: 850px;
		margin: 0 auto;
		padding: 60px 20px 120px;
	}

	.page-header { margin-bottom: 48px; }

	h1 {
		font-size: 3rem;
		font-weight: 700;
		letter-spacing: -0.04em;
		margin-bottom: 15px;
		color: #000;
	}

	.page-subtitle {
		color: #666;
		font-size: 1.1rem;
		max-width: 800px;
		line-height: 1.5;
		margin-bottom: 28px;
	}

	.search-row { margin-bottom: 20px; }

	.search-input {
		width: 100%;
		padding: 12px 16px;
		border: 1px solid #eee;
		border-radius: 10px;
		font-family: inherit;
		font-size: 0.95rem;
		color: #000;
		background: #fff;
		transition: border-color 0.15s;
	}
	.search-input:focus { outline: none; border-color: #000; }
	.search-input::placeholder { color: #bbb; }

	.controls-container {
		border-top: 1px solid #eee;
		padding: 20px 0 4px;
	}

	.control-label {
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 0.7rem;
		color: #999;
		letter-spacing: 0.05em;
		display: block;
		margin-bottom: 10px;
	}

	.tag-cloud {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
	}

	.filter-children {
		margin-top: 10px;
		padding-left: 4px;
	}
	/* .tag-cloud's own `display: flex` has equal specificity to the browser's
	   built-in [hidden] rule and, being an author style, wins — without this,
	   the hidden attribute is silently ignored and the pills never collapse. */
	.filter-children[hidden] { display: none; }

	.filter-tag {
		background: none;
		border: 1px solid #eee;
		padding: 6px 14px;
		border-radius: 20px;
		font-size: 0.7rem;
		font-weight: 700;
		cursor: pointer;
		transition: all 0.15s;
		color: #666;
		font-family: inherit;
	}
	.filter-tag:hover { border-color: #000; color: #000; }
	.filter-tag.active { background: #000; color: #fff; border-color: #000; }

	.filter-tag.parent { border-width: 1.5px; border-color: #ccc; color: #333; }
	.filter-tag.parent:hover { border-color: #000; }
	.filter-tag.parent.active { background: #000; color: #fff; border-color: #000; }

	.filter-tag.child { font-weight: 600; padding: 5px 12px; color: #999; border-color: #f0f0f0; }
	.filter-tag.child:hover { border-color: #000; color: #000; }
	.filter-tag.child.active { background: #000; color: #fff; border-color: #000; }

	.idx-section { margin-top: 12px; }
	.idx-section.hidden { display: none; }

	.idx-divider { height: 1px; background: #eee; margin: 48px 0; }
	.idx-divider.hidden { display: none; }

	.idx-lang-header { margin-bottom: 8px; }

	.idx-lang-title {
		font-size: 1.9rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		color: #000;
		margin: 0;
	}

	.idx-lang-native {
		font-size: 1.9rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: #999;
	}

	.idx-lang-meta {
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 0.78rem;
		color: #bbb;
		margin-top: 6px;
		letter-spacing: 0.02em;
	}

	.idx-level-group { margin-top: 30px; }
	.idx-level-group.hidden { display: none; }

	.idx-level-label {
		display: inline-block;
		padding: 3px 10px;
		border-radius: 999px;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		margin-bottom: 12px;
	}

	.level-n5 { background: #CFEEDA; color: #146B3A; }
	.level-n4 { background: #D3E4FA; color: #1F4F97; }
	.level-n3 { background: #E7D8F5; color: #6B2A98; }
	.level-n2 { background: #FADFB8; color: #A65200; }
	.level-n1 { background: #F6D2D9; color: #96132F; }
	.level-topik1 { background: #F8E3B8; color: #8A5600; }
	.level-topik2 { background: #F8D2BE; color: #A83415; }
	.level-hsk1 { background: #F8E3B8; color: #8A5600; }
	.level-hsk2 { background: #F4DDB5; color: #865700; }
	.level-hsk3 { background: #E7D8F5; color: #6B2A98; }
	.level-hsk4 { background: #D3E4FA; color: #1F4F97; }
	.level-hsk5 { background: #D5E9ED; color: #24606B; }
	.level-hsk6, .level-hsk79 { background: #D8D5F3; color: #53439A; }

	.idx-list { display: flex; flex-direction: column; }

	.idx-row {
		display: block;
		padding: 8px 4px;
		text-decoration: none !important;
		color: inherit;
		border-radius: 6px;
		transition: background 0.12s;
	}
	.idx-row:hover { background: #fafafa; }
	.idx-row.hidden { display: none; }

	.idx-title {
		font-size: 1rem;
		color: #222;
		transition: color 0.12s;
	}
	.idx-row:hover .idx-title { color: #000; text-decoration: underline; text-decoration-color: #ccc; text-underline-offset: 3px; }

	/* The grammar point's original script — still shown, just carrying less
	   visual weight than the English title so a scan of the list reads the
	   titles first, with the script there the moment you're looking for it. */
	.idx-title-detail { color: #aaa; font-weight: 400; }

	.idx-show-toggle {
		display: block;
		margin: 10px 0 0 4px;
		padding: 0;
		background: none;
		border: none;
		font-family: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		color: #999;
		cursor: pointer;
		transition: color 0.15s;
	}
	.idx-show-toggle:hover { color: #000; }
	.idx-show-toggle.hidden { display: none; }



	.empty-state {
		display: none;
		padding: 60px 0;
		text-align: center;
		color: #999;
		font-size: 0.95rem;
	}
	.empty-state.visible { display: block; }
</style>
