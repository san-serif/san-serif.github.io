---
/* CULTURE NOTES - san serif
  - Grouped by content shape, not one flat list: language courses read as a
    syllabus in curriculum order, Musings 수필 reads as a feed in recency
    order. `order` means two different things depending on which bucket a
    note is in, so each bucket sorts itself accordingly instead of sharing
    one global sort control. Musings leads the page (not trailing after both
    courses) since it's the one part of this page that's actually timely.
  - Editorial index styling: no emoji, no "Course" label. Colour appears
    once per level group, not smeared across every row — earned structure,
    not decoration. Hairline rules lifted from about.astro.
  - Nested filter tags: each language's level pills sit in the same row as
    that language, and CULTURE/METHOD (Musings' two content types) sit
    together in their own row — so the tag cloud's structure matches the
    real parent/child relationship instead of flattening everything into
    one list, which previously let someone combine e.g. JLPT N5 with
    KOREAN into a guaranteed-empty result.
  - Dynamic Multi-Tag Filtering (client-side, AND semantics)
  - Live text search (client-side)
*/
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const notes = await getCollection('notes');

// A note belongs to Musings 수필 if it's tagged CULTURE or METHOD, or if it
// has no language tag at all — anything that isn't a graded note in a
// language curriculum. Everything else splits into its language's section
// by the JAPANESE/KOREAN tag.
const isMusings = (n: typeof notes[number]) =>
  n.data.category.includes('CULTURE') || n.data.category.includes('METHOD') ||
  !n.data.category.some(c => ['JAPANESE', 'KOREAN', 'CHINESE'].includes(c));

const japaneseNotes = notes.filter(n => n.data.category.includes('JAPANESE') && !isMusings(n));
const koreanNotes = notes.filter(n => n.data.category.includes('KOREAN') && !isMusings(n));
const musingsNotes = notes.filter(isMusings).sort((a, b) => b.data.order - a.data.order);

const LEVEL_ORDER = ['N5', 'N4', 'N3', 'N2', 'N1', 'TOPIK I', 'TOPIK II'];

// Matches VocabTable's own collapse threshold elsewhere on the site — same
// "Show all N ↓" pattern, not a new interaction. Only applies to the
// default, unfiltered view; any active search or tag filter shows every
// match regardless of this count.
const VISIBLE_COUNT = 12;

// Group a section's notes by level, in curriculum order (level order, then
// ascending lesson order within each level) — the reading order you'd
// actually work through, not publish order.
function groupByLevel(sectionNotes: typeof notes) {
  return LEVEL_ORDER
    .map(level => ({
      level,
      notes: sectionNotes
        .filter(n => n.data.level === level)
        .sort((a, b) => a.data.order - b.data.order),
    }))
    .filter(g => g.notes.length > 0);
}

const japaneseGroups = groupByLevel(japaneseNotes);
const koreanGroups = groupByLevel(koreanNotes);

const allCategories = [...new Set(notes.flatMap(n => n.data.level ? [...n.data.category, n.data.level] : n.data.category))];
const has = (tag: string) => allCategories.includes(tag);

// "JLPT" only gets prefixed on the filter buttons, where N5 sits directly
// next to TOPIK I and needs disambiguating. Inside a section already headed
// "Japanese 日本語", a bare "N5" is unambiguous, so the in-page level labels
// skip the prefix.
const filterLevelLabel = (level: string) => level.startsWith('N') ? `JLPT ${level}` : level;

const LEVEL_CLASSES: Record<string, string> = {
	'N5': 'level-n5', 'N4': 'level-n4', 'N3': 'level-n3', 'N2': 'level-n2', 'N1': 'level-n1',
	'TOPIK I': 'level-topik1', 'TOPIK II': 'level-topik2',
};
const levelClass = (level: string) => LEVEL_CLASSES[level] ?? '';

const rowCategory = (n: typeof notes[number]) =>
  (n.data.level ? [...n.data.category, n.data.level] : n.data.category).join(',').toLowerCase();
const rowSearch = (n: typeof notes[number]) =>
  `${n.data.title} ${n.data.description ?? ''}`.toLowerCase();
---

<Layout title="Notes | san serif" description="Free Korean, Japanese, and Chinese grammar lessons and culture notes, from greetings to formal register, with real example sentences, native-speaker insights, and vocabulary you'll actually use.">
	<main class="wrapper">

		<header class="page-header">
			<h1>Culture Notes</h1>
			<p class="page-subtitle">
				Beyond the dictionary: exploring the unspoken rules and nuances of language.
			</p>

			<div class="search-row">
				<input type="text" class="search-input" id="search-input" placeholder="Search notes by title or description…" />
			</div>

			<div class="controls-container">
				<span class="control-label">LANGUAGE &amp; LEVEL</span>

				{has('JAPANESE') && (
					<div class="nested-filter-group">
						<button class="filter-tag parent" data-tag="japanese">JAPANESE</button>
						{(has('N5') || has('N4') || has('N3') || has('N2') || has('N1')) && <div class="filter-sep"></div>}
						{LEVEL_ORDER.filter(l => l.startsWith('N') && has(l)).map(lvl => (
							<button class="filter-tag child" data-tag={lvl.toLowerCase()}>{filterLevelLabel(lvl)}</button>
						))}
					</div>
				)}

				{has('KOREAN') && (
					<div class="nested-filter-group">
						<button class="filter-tag parent" data-tag="korean">KOREAN</button>
						{(has('TOPIK I') || has('TOPIK II')) && <div class="filter-sep"></div>}
						{LEVEL_ORDER.filter(l => l.startsWith('TOPIK') && has(l)).map(lvl => (
							<button class="filter-tag child" data-tag={lvl.toLowerCase()}>{filterLevelLabel(lvl)}</button>
						))}
					</div>
				)}

				{(has('CULTURE') || has('METHOD')) && (
					<div class="nested-filter-group">
						{has('CULTURE') && <button class="filter-tag parent" data-tag="culture">CULTURE</button>}
						{has('METHOD') && <button class="filter-tag parent" data-tag="method">METHOD</button>}
					</div>
				)}
			</div>
		</header>

		<section class="idx-section" id="section-musings">
			<div class="idx-lang-header">
				<h2 class="idx-lang-title">Musings <span class="idx-lang-native">수필</span></h2>
				<div class="idx-lang-meta" id="meta-musings" data-count={musingsNotes.length}>{musingsNotes.length} {musingsNotes.length === 1 ? 'piece' : 'pieces'} · newest first</div>
			</div>
			<div class="idx-misc-list">
				{musingsNotes.map(note => (
					<a
						href={`/notes/${note.slug || note.id}`}
						class="idx-misc-row"
						data-category={rowCategory(note)}
						data-search={rowSearch(note)}
					>
						<span class="idx-misc-tag">{note.data.category.join(' · ')}</span>
						<h4>{note.data.title}</h4>
						<p>{note.data.description}</p>
					</a>
				))}
			</div>
		</section>

		<div class="idx-divider"></div>

		<section class="idx-section" id="section-japanese">
			<div class="idx-lang-header">
				<h2 class="idx-lang-title">Japanese <span class="idx-lang-native">日本語</span></h2>
				<div class="idx-lang-meta" id="meta-japanese">{japaneseNotes.length} notes · {japaneseGroups.map(g => g.level).join(' → ')}</div>
			</div>
			{japaneseGroups.map(group => (
				<div class="idx-level-group" data-level-group={group.level.toLowerCase()}>
					<span class={`idx-level-label ${levelClass(group.level)}`}>{group.level}</span>
					<div class="idx-list">
						{group.notes.map((note, i) => (
							<a
								href={`/notes/${note.slug || note.id}`}
								class={`idx-row ${i >= VISIBLE_COUNT ? 'idx-row-extra' : ''}`}
								data-category={rowCategory(note)}
								data-search={rowSearch(note)}
							>
								<span class="idx-title">{note.data.title}</span>
							</a>
						))}
					</div>
					{group.notes.length > VISIBLE_COUNT && (
						<button class="idx-show-toggle" data-total={group.notes.length} onclick="toggleLevelGroup(this)">
							Show all {group.notes.length} →
						</button>
					)}
				</div>
			))}
		</section>

		<div class="idx-divider"></div>

		<section class="idx-section" id="section-korean">
			<div class="idx-lang-header">
				<h2 class="idx-lang-title">Korean <span class="idx-lang-native">한국어</span></h2>
				<div class="idx-lang-meta" id="meta-korean">{koreanNotes.length} notes · {koreanGroups.map(g => g.level).join(' → ')}</div>
			</div>
			{koreanGroups.map(group => (
				<div class="idx-level-group" data-level-group={group.level.toLowerCase()}>
					<span class={`idx-level-label ${levelClass(group.level)}`}>{group.level}</span>
					<div class="idx-list">
						{group.notes.map((note, i) => (
							<a
								href={`/notes/${note.slug || note.id}`}
								class={`idx-row ${i >= VISIBLE_COUNT ? 'idx-row-extra' : ''}`}
								data-category={rowCategory(note)}
								data-search={rowSearch(note)}
							>
								<span class="idx-title">{note.data.title}</span>
							</a>
						))}
					</div>
					{group.notes.length > VISIBLE_COUNT && (
						<button class="idx-show-toggle" data-total={group.notes.length} onclick="toggleLevelGroup(this)">
							Show all {group.notes.length} →
						</button>
					)}
				</div>
			))}
		</section>

		<div class="empty-state" id="empty-state">No notes match this combination. Try clearing a tag or the search.</div>

	</main>
</Layout>

<script is:inline>
	const searchInput = document.getElementById('search-input');
	const emptyState = document.getElementById('empty-state');
	const idxRows = Array.from(document.querySelectorAll('.idx-row'));
	const miscRows = Array.from(document.querySelectorAll('.idx-misc-row'));
	const allRows = [...idxRows, ...miscRows];
	const levelGroups = Array.from(document.querySelectorAll('.idx-level-group'));
	const sections = Array.from(document.querySelectorAll('.idx-section'));
	let activeTags = new Set();

	document.querySelectorAll('.filter-tag').forEach(btn => {
		btn.addEventListener('click', () => {
			const tag = btn.getAttribute('data-tag');
			if (activeTags.has(tag)) {
				activeTags.delete(tag);
				btn.classList.remove('active');
			} else {
				activeTags.add(tag);
				btn.classList.add('active');
			}
			applyFilters();
		});
	});

	searchInput.addEventListener('input', applyFilters);

	// "Show all N →" per level-group, same collapse pattern VocabTable
	// already uses elsewhere on the site. Expanding a group persists for
	// the rest of the visit — it doesn't re-collapse just because a filter
	// got cleared.
	window.toggleLevelGroup = function (btn) {
		const group = btn.closest('.idx-level-group');
		const isOpen = group.classList.toggle('group-expanded');
		btn.textContent = isOpen ? 'Show fewer ↑' : `Show all ${btn.dataset.total} →`;
		applyFilters();
	};

	function applyFilters() {
		const query = searchInput.value.trim().toLowerCase();
		const filtersActive = activeTags.size > 0 || query !== '';
		let visibleTotal = 0;

		allRows.forEach(row => {
			const rowTags = row.getAttribute('data-category').split(',');
			const matchesTags = [...activeTags].every(t => rowTags.includes(t));
			const matchesSearch = query === '' || row.getAttribute('data-search').includes(query);
			// "filtered-out" tracks whether a row belongs in this section at
			// all — used for the meta count, which should keep describing
			// the true total even while truncation hides most of it. "hidden"
			// is the actual display toggle: filtered out OR (truncated and
			// its group hasn't been expanded).
			const matchesFilter = matchesTags && matchesSearch;
			row.classList.toggle('filtered-out', !matchesFilter);

			const group = row.closest('.idx-level-group');
			const isExtra = row.classList.contains('idx-row-extra');
			const groupExpanded = !group || group.classList.contains('group-expanded');
			const truncated = !filtersActive && isExtra && !groupExpanded;
			const isVisible = matchesFilter && !truncated;
			row.classList.toggle('hidden', !isVisible);
			if (isVisible) visibleTotal++;
		});

		document.querySelectorAll('.idx-show-toggle').forEach(btn => {
			btn.classList.toggle('hidden', filtersActive);
		});

		// Collapse level-groups and whole sections once nothing inside them
		// matches the filter, so readers don't hit an orphaned "N5" header
		// sitting above nothing. Based on filter match, not truncation — a
		// group with all its extra rows collapsed still has real matches.
		levelGroups.forEach(group => {
			const hasMatch = Array.from(group.querySelectorAll('.idx-row')).some(r => !r.classList.contains('filtered-out'));
			group.classList.toggle('hidden', !hasMatch);
		});

		sections.forEach(section => {
			const hasMatch = Array.from(section.querySelectorAll('.idx-row, .idx-misc-row')).some(r => !r.classList.contains('filtered-out'));
			section.classList.toggle('hidden', !hasMatch);
		});

		updateMeta();
		emptyState.classList.toggle('visible', visibleTotal === 0);
	}

	// The "114 notes · N5 → N4" line under each language heading is static
	// server-rendered text — it has to be recomputed here on every filter
	// change, or it keeps describing the unfiltered set while the list below
	// it shows something else entirely.
	function updateMeta() {
		const japaneseMeta = document.getElementById('meta-japanese');
		const koreanMeta = document.getElementById('meta-korean');
		const musingsMeta = document.getElementById('meta-musings');

		// Counts by filter match, not DOM visibility — truncation hides rows
		// on screen without removing them from what this section "contains",
		// so the count shouldn't drop just because a group is collapsed.
		function describe(sectionEl) {
			const matchingRows = Array.from(sectionEl.querySelectorAll('.idx-row')).filter(r => !r.classList.contains('filtered-out'));
			const matchingLevels = Array.from(sectionEl.querySelectorAll('.idx-level-group'))
				.filter(g => !g.classList.contains('hidden'))
				.map(g => g.getAttribute('data-level-group').toUpperCase());
			const levelText = matchingLevels.length ? ` · ${matchingLevels.join(' → ')}` : '';
			return `${matchingRows.length} note${matchingRows.length === 1 ? '' : 's'}${levelText}`;
		}

		japaneseMeta.textContent = describe(document.getElementById('section-japanese'));
		koreanMeta.textContent = describe(document.getElementById('section-korean'));

		const matchingMisc = Array.from(document.querySelectorAll('.idx-misc-row')).filter(r => !r.classList.contains('filtered-out'));
		musingsMeta.textContent = `${matchingMisc.length} ${matchingMisc.length === 1 ? 'piece' : 'pieces'} · newest first`;
	}

	// Establishes the truncated default view on load — without this, every
	// row (including the ones past VISIBLE_COUNT) would render fully open
	// until the first filter/search interaction.
	applyFilters();
</script>

<style>
	.wrapper {
		max-width: 850px;
		margin: 0 auto;
		padding: 60px 20px 120px;
	}

	.page-header { margin-bottom: 48px; }

	h1 {
		font-size: 3rem;
		font-weight: 700;
		letter-spacing: -0.04em;
		margin-bottom: 15px;
		color: #000;
	}

	.page-subtitle {
		color: #666;
		font-size: 1.1rem;
		max-width: 800px;
		line-height: 1.5;
		margin-bottom: 28px;
	}

	.search-row { margin-bottom: 20px; }

	.search-input {
		width: 100%;
		padding: 12px 16px;
		border: 1px solid #eee;
		border-radius: 10px;
		font-family: inherit;
		font-size: 0.95rem;
		color: #000;
		background: #fff;
		transition: border-color 0.15s;
	}
	.search-input:focus { outline: none; border-color: #000; }
	.search-input::placeholder { color: #bbb; }

	.controls-container {
		border-top: 1px solid #eee;
		padding: 20px 0 4px;
	}

	.control-label {
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 0.7rem;
		color: #999;
		letter-spacing: 0.05em;
		display: block;
		margin-bottom: 10px;
	}

	.nested-filter-group {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 10px;
	}

	.filter-sep {
		width: 1px;
		height: 16px;
		background: #ddd;
		margin: 0 2px;
	}

	.filter-tag {
		background: none;
		border: 1px solid #eee;
		padding: 6px 14px;
		border-radius: 20px;
		font-size: 0.7rem;
		font-weight: 700;
		cursor: pointer;
		transition: all 0.15s;
		color: #666;
		font-family: inherit;
	}
	.filter-tag:hover { border-color: #000; color: #000; }
	.filter-tag.active { background: #000; color: #fff; border-color: #000; }

	.filter-tag.parent { border-width: 1.5px; border-color: #ccc; color: #333; }
	.filter-tag.parent:hover { border-color: #000; }
	.filter-tag.parent.active { background: #000; color: #fff; border-color: #000; }

	.filter-tag.child { font-weight: 600; padding: 5px 12px; color: #999; border-color: #f0f0f0; }
	.filter-tag.child:hover { border-color: #000; color: #000; }
	.filter-tag.child.active { background: #000; color: #fff; border-color: #000; }

	.idx-section { margin-top: 12px; }
	.idx-section.hidden { display: none; }

	.idx-divider { height: 1px; background: #eee; margin: 48px 0; }

	.idx-lang-header { margin-bottom: 8px; }

	.idx-lang-title {
		font-size: 1.9rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		color: #000;
		margin: 0;
	}

	.idx-lang-native {
		font-size: 1.9rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: #999;
	}

	.idx-lang-meta {
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 0.78rem;
		color: #bbb;
		margin-top: 6px;
		letter-spacing: 0.02em;
	}

	.idx-level-group { margin-top: 30px; }
	.idx-level-group.hidden { display: none; }

	.idx-level-label {
		display: inline-block;
		padding: 3px 10px;
		border-radius: 999px;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		margin-bottom: 12px;
	}

	.level-n5 { background: #CFEEDA; color: #146B3A; }
	.level-n4 { background: #D3E4FA; color: #1F4F97; }
	.level-n3 { background: #E7D8F5; color: #6B2A98; }
	.level-n2 { background: #FADFB8; color: #A65200; }
	.level-n1 { background: #F6D2D9; color: #96132F; }
	.level-topik1 { background: #F8E3B8; color: #8A5600; }
	.level-topik2 { background: #F8D2BE; color: #A83415; }

	.idx-list { display: flex; flex-direction: column; }

	.idx-row {
		display: block;
		padding: 8px 4px;
		text-decoration: none !important;
		color: inherit;
		border-radius: 6px;
		transition: background 0.12s;
	}
	.idx-row:hover { background: #fafafa; }
	.idx-row.hidden { display: none; }

	.idx-title {
		font-size: 1rem;
		color: #222;
		transition: color 0.12s;
	}
	.idx-row:hover .idx-title { color: #000; text-decoration: underline; text-decoration-color: #ccc; text-underline-offset: 3px; }

	.idx-show-toggle {
		display: block;
		margin: 10px 0 0 4px;
		padding: 0;
		background: none;
		border: none;
		font-family: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		color: #999;
		cursor: pointer;
		transition: color 0.15s;
	}
	.idx-show-toggle:hover { color: #000; }
	.idx-show-toggle.hidden { display: none; }

	.idx-misc-list { margin-top: 20px; }

	.idx-misc-row {
		display: block;
		text-decoration: none !important;
		padding: 18px 4px;
		border-bottom: 1px solid #f5f5f5;
		border-radius: 6px;
		transition: background 0.12s;
	}
	.idx-misc-row:last-child { border-bottom: none; }
	.idx-misc-row:hover { background: #fafafa; }
	.idx-misc-row.hidden { display: none; }

	.idx-misc-tag { font-size: 0.65rem; font-weight: 800; color: #bbb; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 6px; display: block; }
	.idx-misc-row h4 { font-size: 1.15rem; font-weight: 600; margin: 0 0 6px 0; color: #000; }
	.idx-misc-row p { font-size: 0.92rem; color: #666; line-height: 1.55; margin: 0; max-width: 60ch; }

	.empty-state {
		display: none;
		padding: 60px 0;
		text-align: center;
		color: #999;
		font-size: 0.95rem;
	}
	.empty-state.visible { display: block; }
</style>
