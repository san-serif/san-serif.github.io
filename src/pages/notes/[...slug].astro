---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { isTangent, courseSequence, parseTitle } from '../../lib/notesGrouping';
import { chineseTitleCue } from '../../lib/chineseTitleCue';

export async function getStaticPaths() {
	const notes = await getCollection('notes');
	const japaneseSequence = courseSequence(notes, 'JAPANESE');
	const koreanSequence = courseSequence(notes, 'KOREAN');
	const chineseSequence = courseSequence(notes, 'CHINESE');

	// Previous/Next walks the curriculum in the same order the /notes index
	// lists it in — level order, then ascending lesson order — not raw
	// creation order, so "next" always means the next thing to actually
	// study, never a jump into a different language or level.
	function sequenceInfo(entry: typeof notes[number]) {
		if (isTangent(entry)) return { prevNote: null, nextNote: null, position: null, total: null };
		const sequence = entry.data.category.includes('JAPANESE') ? japaneseSequence
			: entry.data.category.includes('KOREAN') ? koreanSequence
			: entry.data.category.includes('CHINESE') ? chineseSequence
			: null;
		if (!sequence) return { prevNote: null, nextNote: null, position: null, total: null };
		const index = sequence.findIndex(n => n.id === entry.id);
		return {
			prevNote: index > 0 ? sequence[index - 1] : null,
			nextNote: index < sequence.length - 1 ? sequence[index + 1] : null,
			position: index + 1,
			total: sequence.length,
		};
	}

	return notes.map(entry => ({
		// Using slug for cleaner URLs, falling back to ID
		params: { slug: entry.slug || entry.id },
		props: { entry, ...sequenceInfo(entry) },
	}));
}

const { entry, prevNote, nextNote, position, total } = Astro.props;
const { Content } = await render(entry);

const LEVEL_CLASSES: Record<string, string> = {
	'N5': 'level-n5', 'N4': 'level-n4', 'N3': 'level-n3', 'N2': 'level-n2', 'N1': 'level-n1',
	'TOPIK I': 'level-topik1', 'TOPIK II': 'level-topik2',
	'HSK 1': 'level-hsk1', 'HSK 2': 'level-hsk2', 'HSK 3': 'level-hsk3', 'HSK 4': 'level-hsk4',
	'HSK 5': 'level-hsk5', 'HSK 6': 'level-hsk6', 'HSK 7–9': 'level-hsk79',
};
const levelClass = entry.data.level ? LEVEL_CLASSES[entry.data.level] ?? '' : '';
	const levelLabel = entry.data.level?.startsWith('N') ? `JLPT ${entry.data.level}` : entry.data.level;

const title = parseTitle(entry.data.title);
const titleCue = chineseTitleCue(entry);
const prevTitle = prevNote ? parseTitle(prevNote.data.title) : { main: '', detail: null };
const nextTitle = nextNote ? parseTitle(nextNote.data.title) : { main: '', detail: null };
const language = isTangent(entry) ? null
	: entry.data.category.includes('JAPANESE') ? 'japanese'
	: entry.data.category.includes('KOREAN') ? 'korean'
	: entry.data.category.includes('CHINESE') ? 'chinese'
	: null;
const linkedApp = language === 'korean'
	? { name: 'Sajeon', icon: '/sajeon-icon.png', href: '/portfolio/sajeon', detail: 'If you have Sajeon installed, tap an example sentence or vocabulary word to open it in the app.' }
	: language === 'japanese'
	? { name: 'Kaku', icon: '/kaku-icon.png', href: '/portfolio/kaku', detail: 'Sentences and words open in Kaku when the app is installed.' }
	: language === 'chinese'
	? { name: 'Yinpin', icon: '/yinpin-icon.png', href: '/portfolio/yinpin', detail: 'Vocabulary words open in Yinpin when the app is installed.' }
	: null;
---

<Layout title={`${entry.data.title} | san serif`} description={entry.data.description}>
	<main class="wrapper">
		<a href={language ? `/learn/${language}` : '/notes'} class="back-link">← {language ? `Back to ${language[0].toUpperCase() + language.slice(1)} course` : 'Back to notes'}</a>

		<article class="post">
			<header class="post-header">
				{/* Category, and — for course lessons — position within the
				    curriculum. A raw "Note 85" told a reader nothing about
				    where they were in the syllabus; "12 of 78" does. */}
				<div class="type-row">
					<span class="type">{[
						entry.data.category?.join(' + '),
						position && total ? `${position} of ${total}` : null,
					].filter(Boolean).join(' / ')}</span>
					{entry.data.level && <span class={`level-badge ${levelClass}`}>{levelLabel}</span>}
				</div>

			<h1>{title.main}{title.detail ? <span class="title-detail"> {title.detail}</span> : titleCue && <span class="title-detail" lang="zh">例 · {titleCue}</span>}</h1>

				{/* Tags Array */}
				{entry.data.tags && entry.data.tags.length > 0 && (
					<div class="tags">
						{entry.data.tags.map(tag => (
							<span class="tag">#{tag}</span>
						))}
					</div>
				)}
			</header>

			<section class="analysis" data-language={language}>
				<Content />
			</section>

			{language && (
				<section class="lesson-finish" data-lesson-id={entry.id} data-course={language}>
					{entry.data.practice && (
						<div class="practice-check">
							<p class="finish-eyebrow">TRY IT YOURSELF</p>
							<h2>Quick check</h2>
							<p class="practice-prompt">{entry.data.practice.prompt}</p>
							<div class="practice-choices">
								{entry.data.practice.choices.map((choice, index) => (
									<button type="button" data-choice={index} data-correct={index === entry.data.practice.answer}>{choice}</button>
								))}
							</div>
							<p class="practice-feedback" role="status" aria-live="polite" data-explanation={entry.data.practice.explanation}></p>
						</div>
					)}
					<div class="finish-grid">
						<div class="complete-card">
							<div><p class="card-eyebrow">YOUR PROGRESS</p><h2>Finished this lesson?</h2><p>Save your place in this course.</p></div>
							<button type="button" id="complete-lesson">Mark complete ✓</button>
						</div>
						{linkedApp && <aside class="app-card" aria-label={`${linkedApp.name} links`}>
							<a class="app-link-icon" href={linkedApp.href} aria-label={`About ${linkedApp.name}`}><img src={linkedApp.icon} alt="" width="44" height="44" loading="lazy" /></a>
							<div>
								<a class="app-link-title" href={linkedApp.href}>{linkedApp.name} ↗</a>
								<p>{linkedApp.detail}</p>
							</div>
						</aside>}
					</div>
				</section>
			)}

			{(prevNote || nextNote) && (
				<nav class="lesson-nav">
					{prevNote ? (
						<a href={`/notes/${prevNote.slug || prevNote.id}`} class="lesson-nav-link prev">
							<span class="lesson-nav-label">← Previous</span>
							<span class="lesson-nav-title">{prevTitle.main}</span>
							{prevTitle.detail && <span class="lesson-nav-detail">{prevTitle.detail}</span>}
						</a>
					) : <span class="lesson-nav-spacer"></span>}
					{nextNote && (
						<a href={`/notes/${nextNote.slug || nextNote.id}`} class="lesson-nav-link next">
							<span class="lesson-nav-label">Next →</span>
							<span class="lesson-nav-title">{nextTitle.main}</span>
							{nextTitle.detail && <span class="lesson-nav-detail">{nextTitle.detail}</span>}
						</a>
					)}
				</nav>
			)}
		</article>
	</main>
</Layout>

<script is:inline>
	const finish = document.querySelector('.lesson-finish');
	if (finish) {
		const storageKey = 'sanserif:completed:v1';
		const lastKey = 'sanserif:last:v1';
		const completeButton = document.getElementById('complete-lesson');
		try {
			const last = JSON.parse(localStorage.getItem(lastKey) || '{}');
			const saved = last && typeof last === 'object' && !Array.isArray(last) ? last : {};
			saved[finish.dataset.course] = {
				id: finish.dataset.lessonId,
				href: location.pathname,
				title: document.querySelector('.post-header h1').textContent.trim(),
				updatedAt: Date.now(),
			};
			localStorage.setItem(lastKey, JSON.stringify(saved));
		} catch {}
		let completed = [];
		try { completed = JSON.parse(localStorage.getItem(storageKey) || '[]'); } catch {}
		if (!Array.isArray(completed)) completed = [];
		const updateButton = () => {
			const isComplete = completed.includes(finish.dataset.lessonId);
			completeButton.textContent = isComplete ? 'Completed ✓' : 'Mark complete ✓';
			completeButton.setAttribute('aria-pressed', String(isComplete));
		};
		updateButton();
		completeButton.addEventListener('click', () => {
			const id = finish.dataset.lessonId;
			completed = completed.includes(id) ? completed.filter(item => item !== id) : [...completed, id];
			try { localStorage.setItem(storageKey, JSON.stringify(completed)); } catch {}
			updateButton();
		});

		const feedback = finish.querySelector('.practice-feedback');
		finish.querySelectorAll('[data-choice]').forEach(button => {
			button.addEventListener('click', () => {
				const correct = button.dataset.correct === 'true';
				finish.querySelectorAll('[data-choice]').forEach(choice => {
					choice.classList.remove('chosen', 'correct');
					choice.setAttribute('aria-pressed', String(choice === button));
				});
				button.classList.add('chosen');
				if (correct) button.classList.add('correct');
				feedback.textContent = (correct ? 'Correct. ' : 'Try again. ') + feedback.dataset.explanation;
			});
		});
	}
</script>

<style>
	.lesson-finish { margin-top: 4.5rem; border-top: 1px solid #e8e8e8; }
	.finish-eyebrow { color: #888; font-size: .7rem; font-weight: 700; letter-spacing: .13em; margin: 0 0 12px; }
	.practice-check { padding: 32px 0 34px; }
	.practice-check h2, .complete-card h2 { margin: 0 0 10px; font-size: 1.25rem; letter-spacing: -.03em; }
	.practice-prompt { color: #444; line-height: 1.6; margin: 0 0 18px; }
	.practice-choices { display: grid; gap: 9px; }
	.practice-choices button { text-align: left; background: #fff; color: #222; border: 1px solid #ddd; border-radius: 8px; padding: 13px 15px; font: inherit; cursor: pointer; }
	.practice-choices button:hover { border-color: #777; }
	.practice-choices button.chosen { border-color: #111; background: #f5f5f5; }
	.practice-choices button.correct { border-color: #287e5b; background: #f1faf5; }
	.practice-feedback { min-height: 1.4em; margin: 14px 0 0; color: #555; font-size: .9rem; line-height: 1.5; }
	.finish-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 12px; padding-top: 32px; margin-bottom: 2.5rem; }
	.complete-card, .app-card { min-width: 0; min-height: 205px; border-radius: 14px; padding: 24px; display: flex; flex-direction: column; align-items: flex-start; }
	.complete-card { justify-content: space-between; gap: 24px; background: #f7f7f7; border: 1px solid #eaeaea; color: #222; }
	.card-eyebrow { margin: 0 0 18px; color: #888; font-size: .68rem; font-weight: 700; letter-spacing: .12em; }
	.complete-card h2 { color: #222; }
	.complete-card p:not(.card-eyebrow) { margin: 0; color: #666; font-size: .85rem; line-height: 1.55; }
	.complete-card button { background: #222; color: #fff; border: 1px solid #222; border-radius: 7px; padding: 10px 14px; font: inherit; font-size: .82rem; font-weight: 700; cursor: pointer; }
	.complete-card button:hover { background: #444; }
	.complete-card button[aria-pressed="true"] { background: #fff; color: #222; }
	.app-card { gap: 18px; background: #f7f7f7; border: 1px solid #eaeaea; }
	.app-link-icon { flex: none; line-height: 0; }
	.app-link-icon img { display: block; width: 44px; height: 44px; object-fit: cover; border-radius: 10px; }
	.app-link-title { color: #222; font-size: 1.1rem; font-weight: 700; text-decoration: none; }
	.app-link-title:hover { text-decoration: underline; text-underline-offset: 2px; }
	.app-card p { margin: 8px 0 0; color: #666; font-size: .82rem; line-height: 1.5; }
	@media (max-width: 600px) {
		.finish-grid { gap: 8px; }
		.complete-card, .app-card { min-height: 0; padding: 16px; }
		.complete-card { gap: 20px; }
		.complete-card h2 { font-size: 1.05rem; }
		.complete-card button { padding: 9px 10px; }
		.app-card { gap: 12px; }
		.app-link-icon img { width: 40px; height: 40px; }
	}
	.wrapper { max-width: 750px; margin: 0 auto; padding: 40px 20px 100px; }

	.back-link {
		display: inline-block;
		font-size: 0.85rem;
		font-weight: 600;
		color: #999;
		text-decoration: none;
		margin-bottom: 32px;
		transition: color 0.15s;
	}
	.back-link:hover { color: #000; }

	.post-header { margin-bottom: 60px; }
	
	.type-row {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 12px;
	}

	.type {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: #999;
		font-weight: 700;
	}

	h1 {
		font-size: 3rem;
		font-weight: 700;
		letter-spacing: -0.05em;
		line-height: 1.1;
		margin: 0 0 20px 0;
		color: #000;
	}

	/* The grammar point's original script — kept, just carrying less visual
	   weight than the English title. Hierarchy comes from weight as well as
	   size now, not size and colour alone — bold-but-shrunken-and-faded read
	   as an afterthought rather than a considered subtitle, and shrinking it
	   too far made the CJK/Hangul characters (already visually denser than
	   Latin letters at an equivalent size) look disproportionately small. */
	.title-detail {
		display: block;
		font-size: 1.8rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: #999;
		margin-top: 8px;
	}

	.level-badge {
		display: inline-block;
		padding: 4px 12px;
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.05em;
	}

	.level-n5 { background: #CFEEDA; color: #146B3A; }
	.level-n4 { background: #D3E4FA; color: #1F4F97; }
	.level-n3 { background: #E7D8F5; color: #6B2A98; }
	.level-n2 { background: #FADFB8; color: #A65200; }
	.level-n1 { background: #F6D2D9; color: #96132F; }
	.level-topik1 { background: #F8E3B8; color: #8A5600; }
	.level-topik2 { background: #F8D2BE; color: #A83415; }
	.level-hsk1, .level-hsk2 { background: #F8D2BE; color: #A83415; }
	.level-hsk3, .level-hsk4 { background: #F8E3B8; color: #8A5600; }
	.level-hsk5, .level-hsk6, .level-hsk79 { background: #D8D5F3; color: #53439A; }

	.tags { display: flex; gap: 12px; }
	
	.tag { 
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.8rem; 
		color: #bbb; 
	}
	
	/* MARKDOWN STYLES */
	.analysis :global(p) { font-size: 1.15rem; line-height: 1.7; color: #333; margin-bottom: 2rem; }
	.analysis :global([lang="ko"]) { font-family: "Noto Sans KR", sans-serif; }
	
	.analysis :global(h3) { 
		font-size: 1.2rem; 
		text-transform: uppercase; 
		letter-spacing: 0.05em; 
		color: #000; 
		margin: 3.5rem 0 1.2rem 0; 
		border-bottom: 1px solid #eaeaea; 
		padding-bottom: 8px; 
	}
	
	.analysis :global(img) { 
		display: block;
		max-width: 100%; 
		height: auto;
		margin: 3.5rem auto; 
		border-radius: 12px; 
	}

	.analysis :global(blockquote) { 
		border-left: 2px solid #000; 
		padding-left: 24px; 
		margin: 3rem 0; 
		font-style: italic; 
		color: #555; 
	}

	.analysis :global(ul) { margin-bottom: 2rem; padding-left: 20px; }
	.analysis :global(li) { margin-bottom: 12px; font-size: 1.1rem; color: #444; }
	.analysis :global(strong) { color: #000; font-weight: 700; }

	.analysis :global(a) {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: #bbb;
		text-underline-offset: 3px;
		transition: text-decoration-color 0.15s;
	}
	.analysis :global(a:hover) { text-decoration-color: #000; }

	/* TABLE STYLES FOR THE GLOSSARY */
	.analysis :global(table) { width: 100%; border-collapse: collapse; margin: 2rem 0; }
	.analysis :global(th) { text-align: left; font-size: 0.8rem; text-transform: uppercase; color: #999; padding: 12px; border-bottom: 1px solid #eee; }
	.analysis :global(td) { padding: 12px; border-bottom: 1px solid #eee; font-size: 1rem; }

	/* PREVIOUS / NEXT LESSON NAV */
	.lesson-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 20px;
		margin-top: 5rem;
		padding-top: 2rem;
		border-top: 1px solid #eaeaea;
	}

	.lesson-nav-link {
		display: flex;
		flex-direction: column;
		gap: 6px;
		text-decoration: none !important;
		padding: 16px;
		border-radius: 10px;
		transition: background 0.15s;
	}
	.lesson-nav-link:hover { background: #fafafa; }
	.lesson-nav-link.next { text-align: right; align-items: flex-end; grid-column: 2; }
	.lesson-nav-spacer { grid-column: 1; }

	.lesson-nav-label {
		font-size: 0.7rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: #999;
	}

	.lesson-nav-title {
		font-size: 1rem;
		font-weight: 600;
		color: #000;
	}

	.lesson-nav-detail {
		font-size: 0.85rem;
		color: #555;
	}

	@media (max-width: 600px) {
		.lesson-nav { grid-template-columns: 1fr; }
		.lesson-nav-link.next { text-align: left; align-items: flex-start; grid-column: 1; }
	}
</style>
