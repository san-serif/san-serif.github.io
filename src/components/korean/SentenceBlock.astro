---
// A single formal/polite/casual example sentence with romanization toggle,
// sajeon deep-link, and TTS. Needs KoreanLessonHead rendered earlier on the
// page (it defines the shared styles + window.setLevel/openSajeonReader/speak).
interface Props {
  formal?: string;
  formalRom?: string;
  polite: string;
  politeRom: string;
  casual: string;
  casualRom?: string;
  english: string;
}

const { formal, formalRom, polite, politeRom, casual, casualRom, english } = Astro.props;
---

<div
  class="sentence-block dynamic-text"
  data-formal={formal}
  data-formal-rom={formalRom}
  data-polite={polite}
  data-polite-rom={politeRom}
  data-casual={casual}
  data-casual-rom={casualRom}
>
  <div class="kr-row">
    <a href="javascript:void(0)" class="reader-link" onclick="openSajeonReader(this)">{polite}</a>
    <button class="tts-btn" onclick="speakActive(this)">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 5L6 9H2v6h4l5 4V5z"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
    </button>
  </div>
  <div class="rom">{politeRom}</div>
  <div class="en-row">{english}</div>
</div>
