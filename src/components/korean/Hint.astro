---
// A native-speaker insight: how Koreans actually use the grammar point
// above in real speech, as opposed to the textbook rule. Styled as a
// left-bordered aside to match the site's existing blockquote treatment,
// rather than a boxed-in callout with its own background color.
//
// type="mistake" is the same minimal shape with a second voice: for the
// moment a lesson calls out a specific, common learner error (wrong
// particle, wrong verb, etc) rather than general usage insight. It only
// swaps the label text — an earlier version also recoloured the border
// into warm orange, borrowed from the JLPT N2 badge, but that colour is
// earned there (a wayfinding badge) and wasn't earned here; reusing it for
// an unrelated purpose just looked like it didn't belong on the page.
//
// Usage: <Hint>Some insight about real usage.</Hint>
//        <Hint type="mistake">A specific error learners actually make.</Hint>
interface Props {
  type?: 'insight' | 'mistake';
}

const { type = 'insight' } = Astro.props;
const label = type === 'mistake' ? 'Watch Out' : 'In Real Life';
---

<div class={`hint-box ${type}`}>
  <div class="hint-label">{label}</div>
  <div class="hint-content"><slot /></div>
</div>

<style>
  .hint-box {
    border-left: 2px solid #000;
    padding-left: 20px;
    margin: 2.5rem 0;
  }
  .hint-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: #999;
    margin-bottom: 6px;
  }

  .hint-content { font-size: 0.95rem; line-height: 1.65; color: #555; font-style: italic; }
  .hint-content :global(p) { margin: 0; }
  .hint-content :global(strong) { color: #222; }
  .hint-content :global(a) {
    color: #222;
    text-decoration: underline;
    text-decoration-color: #bbb;
    text-underline-offset: 3px;
  }
  .hint-content :global(a:hover) { text-decoration-color: #222; }
</style>
