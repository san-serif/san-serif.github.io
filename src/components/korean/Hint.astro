---
// A native-speaker insight: how Koreans actually use the grammar point
// above in real speech, as opposed to the textbook rule. Styled as a
// left-bordered aside to match the site's existing blockquote treatment,
// rather than a boxed-in callout with its own background color.
//
// type="mistake" labels a specific learner error. type="clarification"
// marks a definition that needs extra explanation, with a distinct label
// and background so it doesn't read as another real-life usage note.
//
// Usage: <Hint>Some insight about real usage.</Hint>
//        <Hint type="mistake">A specific error learners actually make.</Hint>
//        <Hint type="clarification">A definition unpacked.</Hint>
interface Props {
  type?: 'insight' | 'mistake' | 'clarification';
}

const { type = 'insight' } = Astro.props;
const labels = {
  insight: 'In Real Life',
  mistake: 'Watch Out',
  clarification: 'Clarification',
};
const label = labels[type];
---

<div class={`hint-box ${type}`}>
  <div class="hint-label">{label}</div>
  <div class="hint-content"><slot /></div>
</div>

<style>
  .hint-box {
    border-left: 2px solid #000;
    padding-left: 20px;
    margin: 2.5rem 0;
  }
  .hint-box.clarification {
    border-left: 3px solid #c39a28;
    border-radius: 3px;
    background: #fff8df;
    padding: 14px 18px;
  }
  .hint-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: #999;
    margin-bottom: 6px;
  }
  .clarification .hint-label { color: #806418; }

  .hint-content { font-size: 0.95rem; line-height: 1.65; color: #555; font-style: italic; }
  .clarification .hint-content { color: #494126; font-style: normal; }
  .hint-content :global(p) { margin: 0; }
  .hint-content :global(strong) { color: #222; }
  .hint-content :global(a) {
    color: #222;
    text-decoration: underline;
    text-decoration-color: #bbb;
    text-underline-offset: 3px;
  }
  .hint-content :global(a:hover) { text-decoration-color: #222; }
</style>
