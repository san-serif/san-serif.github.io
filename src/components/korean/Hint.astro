---
// A lesson aside for either grammar/learning hints or real-life usage.
// Yellow hints use a soft bubble; real-life notes use a left-bordered aside.
//
// Usage: <Hint type="hint">A grammar pattern, exception, or learner tip.</Hint>
//        <Hint type="insight">How the pattern is used in real life.</Hint>
interface Props {
  type?: 'insight' | 'hint';
}

const { type = 'hint' } = Astro.props;
const labels = {
  insight: 'In Real Life',
  hint: 'Hint',
};
const label = labels[type];
---

<div class={`hint-box ${type}`}>
  <div class="hint-label">{label}{type === 'hint' && <span class="korean-hint-word" lang="ko"> · 힌트</span>}</div>
  <div class="hint-content"><slot /></div>
</div>

<style>
  .hint-box {
    border-left: 2px solid #000;
    padding-left: 20px;
    margin: 2.5rem 0;
  }
  .hint-box.hint {
    border: 1px solid #f0dfa5;
    border-radius: 10px;
    background: #fff8df;
    padding: 14px 18px;
  }
  .hint-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: #999;
    margin-bottom: 6px;
  }
  .hint .hint-label { color: #806418; }
  .korean-hint-word { display: none; }
  :global(.analysis[data-language="korean"]) .korean-hint-word { display: inline; }

  .hint-content { font-size: 0.95rem; line-height: 1.65; color: #555; font-style: italic; }
  .hint .hint-content { color: #494126; font-style: normal; }
  .hint-content :global(p) { margin: 0; }
  .hint-content :global(strong) { color: #222; }
  .hint-content :global(a) {
    color: #222;
    text-decoration: underline;
    text-decoration-color: #bbb;
    text-underline-offset: 3px;
  }
  .hint-content :global(a:hover) { text-decoration-color: #222; }
</style>
