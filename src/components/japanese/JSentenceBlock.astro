---
// A single Japanese example sentence with furigana/romaji/off toggle, Kaku
// deep-link, and TTS. Needs JapaneseLessonHead rendered earlier on the page
// (it defines the shared styles + window.setReadingMode/openKakuSentence/speak).
//
// `furigana` uses bracket notation to mark kanji readings, e.g.
// "田中[たなか]さんに本[ほん]をあげました。" — a kanji run immediately
// followed by [reading] gets a ruby annotation; everything else (kana,
// punctuation) passes through untouched. The plain and furigana renderings
// are both derived from this one string so they can't drift out of sync.
interface Props {
  furigana: string;
  romaji: string;
  english: string;
}

const { furigana, romaji, english } = Astro.props;

// Only a contiguous run of kanji immediately before [reading] becomes the
// ruby base; kana, romaji, and punctuation around it are left untouched.
const FURIGANA_PATTERN = /([一-鿿々]+)\[([^\[\]]+)\]/g;
const furiganaHtml = furigana.replace(FURIGANA_PATTERN, '<ruby>$1<rt>$2</rt></ruby>');
const plain = furigana.replace(FURIGANA_PATTERN, '$1');
---

<div class="sentence-block jp-dynamic-text" data-furigana-html={furiganaHtml} data-plain={plain} data-romaji={romaji}>
  <div class="jp-row">
    <a href="javascript:void(0)" class="reader-link" onclick="openKakuSentenceFromEl(this)" set:html={furiganaHtml} />
    <button class="tts-btn" onclick="speakActive(this)">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 5L6 9H2v6h4l5 4V5z"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
    </button>
  </div>
  <div class="rom"></div>
  <div class="en-row">{english}</div>
</div>
